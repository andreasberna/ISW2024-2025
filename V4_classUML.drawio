r {\n    + placeToDTO(place: Place): PlaceDTO\n    + visitTypeToDTO(visitType: VisitType): VisitTypeDTO\n    + volunteerToDTO(volunteer: Volunteer): VolunteerDTO\n    + planToDTO(plan: MonthlyVisitPlan, visitTypes: List&lt;VisitType&gt;): MonthlyPlanDTO\n    + toVisitOccurrenceDTO(plan: MonthlyVisitPlan, visit: PlannedVisit,\n                           visitType: VisitType, includeBookings: boolean): VisitOccurrenceDTO\n  }\n\n  class JSONSupport {\n    + serializeConfigurator(map: Map&lt;String, Configurator&gt;): String\n    + deserializeConfigurator(json: String): Map&lt;String, Configurator&gt;\n    + serializeVolunteerMap(map: Map&lt;String, Volunteer&gt;): String\n    + deserializeVolunteerMap(json: String): Map&lt;String, Volunteer&gt;\n    + serializePlaceMap(map: Map&lt;String, Place&gt;): String\n    + deserializePlaceMap(json: String): Map&lt;String, Place&gt;\n    + serializeVisitTypeMap(map: Map&lt;String, VisitType&gt;): String\n    + deserializeVisitTypeMap(json: String): Map&lt;String, VisitType&gt;\n    + serializeMonthlyVisitPlanMap(map: Map&lt;String, MonthlyVisitPlan&gt;): String\n    + deserializeMonthlyVisitPlanMap(json: String): Map&lt;String, MonthlyVisitPlan&gt;\n    + serializeBeneficiaryMap(map: Map&lt;String, Beneficiary&gt;): String\n    + deserializeBeneficiaryMap(json: String): Map&lt;String, Beneficiary&gt;\n    + serializeSystemSettings(settings: SystemSettings): String\n    + deserializeSystemSettings(json: String): SystemSettings\n    + serializeProvisionedCredentials(store: ProvisionedCredentialStore): String\n    + deserializeProvisionedCredentials(json: String): ProvisionedCredentialStore\n  }\n\n  class AvailabilitySubmissionPolicy {\n    + isWindowOpen(referenceMonth: YearMonth, today: LocalDate): boolean\n    + nextSubmissionMonth(today: LocalDate): YearMonth\n  }\n\n  class ExcludedDatePolicy {\n    + allowedMonth(referenceDate: LocalDate): YearMonth\n  }\n\n  class PlanningWindowPolicy {\n    + resolveNextPlanningMonth(today: LocalDate): YearMonth\n  }\n}\n\npackage \&quot;cli\&quot; {\n  class PromptReader {\n    - scanner: Scanner\n    + PromptReader(scanner: Scanner)\n    + readLine(prompt: String): String\n    + readInt(prompt: String): int\n    + readLocalDate(prompt: String): LocalDate\n    + readYesNo(prompt: String): boolean\n  }\n\n  class Printer {\n    + println(message: String)\n    + print(message: String)\n    + printSeparator()\n  }\n\n  class VolunteerCliSupport {\n    - volunteerService: VolunteerService\n    - printer: Printer\n    - promptReader: PromptReader\n    + VolunteerCliSupport(volunteerService: VolunteerService, printer: Printer, promptReader: PromptReader)\n    + run()\n    + handleAvailability()\n    + handleSchedule()\n    + handleGuidedVisits()\n  }\n\n  class BeneficiaryCommandHandler {\n    - beneficiaryService: BeneficiaryService\n    - printer: Printer\n    - promptReader: PromptReader\n    + BeneficiaryCommandHandler(beneficiaryService: BeneficiaryService, printer: Printer, promptReader: PromptReader)\n    + run()\n    + handleRegistration()\n    + handleLogin()\n    + handleBooking()\n    + handleCancellation()\n  }\n\n  class VolunteerCommandHandler {\n    - volunteerService: VolunteerService\n    - printer: Printer\n    - promptReader: PromptReader\n    + VolunteerCommandHandler(volunteerService: VolunteerService, printer: Printer, promptReader: PromptReader)\n    + run()\n    + handleFirstAccess()\n    + handleLogin()\n  }\n\n  class ConfiguratorCommandHandler {\n    - configuratorService: ConfiguratorService\n    - volunteerService: VolunteerService\n    - printer: Printer\n    - promptReader: PromptReader\n    + ConfiguratorCommandHandler(configuratorService: ConfiguratorService, volunteerService: VolunteerService,\n                                 printer: Printer, promptReader: PromptReader)\n    + run()\n    + handleFirstAccess()\n    + handleLogin()\n    + handleCatalogManagement()\n    + handlePlanning()\n  }\n\n  class FirstAccessSetup 