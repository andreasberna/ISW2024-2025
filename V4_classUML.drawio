        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\nskinparam shadowing false\nskinparam packageStyle rectangle\nhide circle\n\npackage \&quot;model\&quot; {\n  class Configurator {\n    - nickname: String\n    - password: String\n    + Configurator(nickname: String, password: String)\n    + getNickname(): String\n    + getPassword(): String\n    + setNickname(nickname: String)\n    + setPassword(password: String)\n  }\n\n  class Beneficiary {\n    - username: String\n    - password: String\n    - fullName: String\n    + Beneficiary(username: String, password: String, fullName: String)\n    + getUsername(): String\n    + getPassword(): String\n    + getFullName(): String\n    + setUsername(username: String)\n    + setPassword(password: String)\n    + setFullName(fullName: String)\n    + passwordMatches(candidate: String): boolean\n  }\n\n  class Volunteer {\n    - nickname: String\n    - password: String\n    - personalCredentialsDefined: boolean\n    - visitsAttending: List&lt;VisitType&gt;\n    - availabilities: Map&lt;YearMonth, MonthlyAvailability&gt;\n    - scheduledShifts: Map&lt;YearMonth, List&lt;AssignedShift&gt;&gt;\n    - active: boolean\n    + Volunteer(nickname: String, password: String)\n    + isFirstAccessPending(): boolean\n    + setPersonalCredentials(password: String)\n    + passwordMatches(candidate: String): boolean\n    + addVisit(visit: VisitType)\n    + removeVisit(visit: VisitType)\n    + getAvailabilities(): Map&lt;YearMonth, MonthlyAvailability&gt;\n    + findAvailability(month: YearMonth): Optional&lt;MonthlyAvailability&gt;\n    + registerAvailability(availability: MonthlyAvailability, today: LocalDate)\n    + getScheduledShifts(): Map&lt;YearMonth, List&lt;AssignedShift&gt;&gt;\n    + getShiftsForMonth(month: YearMonth): List&lt;AssignedShift&gt;\n    + assignShifts(month: YearMonth, shifts: List&lt;AssignedShift&gt;)\n    + deactivate()\n    + activate()\n  }\n\n  class Place {\n    - placeTitle: String\n    - placeDescription: String\n    - location: String\n    - visits: List&lt;VisitType&gt;\n    + Place(placeTitle: String, placeDescription: String, location: String)\n    + getPlaceTitle(): String\n    + getPlaceDescription(): String\n    + getLocation(): String\n    + getVisits(): List&lt;VisitType&gt;\n    + setVisits(visits: List&lt;VisitType&gt;)\n    + addVisit(visit: VisitType)\n    + removeVisit(visit: VisitType)\n  }\n\n  class TimeSlot {\n    - day: DayOfWeek\n    - startTime: LocalTime\n    - duration: Duration\n    + TimeSlot(day: DayOfWeek, startTime: LocalTime, duration: Duration)\n    + getDay(): DayOfWeek\n    + getStartTime(): LocalTime\n    + getDuration(): Duration\n    + setDay(day: DayOfWeek)\n    + setStartTime(startTime: LocalTime)\n    + setDuration(duration: Duration)\n  }\n\n  class VisitType {\n    - id: String\n    - visitTitle: String\n    - visitDescription: String\n    - visitMeetLocation: String\n    - validFrom: LocalDate\n    - validTo: LocalDate\n    - schedules: List&lt;TimeSlot&gt;\n    - ticketRequired: Boolean\n    - minParticipants: int\n    - maxParticipants: int\n    - place: Place\n    - guides: List&lt;Volunteer&gt;\n    - state: VisitState\n    - visitDate: LocalDate\n    - enrollmentDeadline: LocalDate\n    - enrolled: int\n    + VisitType(id: String, visitTitle: String, visitDescription: String, visitMeetLocation: String,\n                validFrom: LocalDate, validTo: LocalDate, schedules: List&lt;TimeSlot&gt;,\n                ticketRequired: Boolean, minParticipants: int, maxParticipants: int,\n                place: Place, guides: List&lt;Volunteer&gt;)\n    + addSchedule(timeSlot: TimeSlot)\n    + removeSchedule(timeSlot: TimeSlot)\n    + addGuide(volunteer: Volunteer)\n    + removeGuide(volunteer: Volunteer)\n    + addEnrollment(n: int)\n    + removeEnrollment(n: int)\n    + updateState(today: LocalDate)\n    + generateOccurrences(month: YearMonth): List&lt;PlannedVisit&gt;\n    + isValidOn(date: LocalDate): boolean\n    + getGuides(): List&lt;Volunteer&gt;\n    + getSchedules(): List&lt;TimeSlot&gt;\n    + setVisitDate(visitDate: LocalDate)\n    + setEnrollmentDeadline(enrollmentDeadline: LocalDate)\n    + getState(): VisitState\n  }\n\n  class VisitBooking {\n    - code: String\n    - beneficiaryUsername: String\n    - beneficiaryName: String\n    - participants: int\n    - notes: String\n    + VisitBooking(code: String, beneficiaryUsername: String, beneficiaryName: String,\n                   participants: int, notes: String)\n    + getCode(): String\n    + getBeneficiaryUsername(): String\n    + getBeneficiaryName(): String\n    + getParticipants(): int\n    + getNotes(): String\n  }\n\n  class PlannedVisit {\n    - id: String\n    - date: LocalDate\n    - timeSlot: TimeSlot\n    - visitTypeId: String\n    - assignedVolunteerIds: List&lt;String&gt;\n    - proposable: boolean\n    - status: VisitStatus\n    - bookings: List&lt;VisitBooking&gt;\n    + PlannedVisit(id: String, date: LocalDate, timeSlot: TimeSlot, visitTypeId: String,\n                   proposable: boolean, assignedVolunteerIds: List&lt;String&gt;,\n                   status: VisitStatus, bookings: List&lt;VisitBooking&gt;)\n    + assignVolunteer(volunteerId: String)\n    + unassignVolunteer(volunteerId: String): boolean\n    + clearAssignements()\n    + getStatus(): VisitStatus\n    + setStatus(status: VisitStatus)\n    + getBookings(): List&lt;VisitBooking&gt;\n    + addBooking(booking: VisitBooking)\n    + removeBookingByCode(bookingCode: String): boolean\n    + getBookedParticipants(): int\n    + findBookingByCode(code: String): VisitBooking\n  }\n\n  class AssignedShift {\n    - date: LocalDate\n    - visitTypeId: String\n    - slot: TimeSlot\n    + AssignedShift(date: LocalDate, visitTypeId: String, slot: TimeSlot)\n    + getDate(): LocalDate\n    + getVisitTypeId(): String\n    + getSlot(): TimeSlot\n  }\n\n  class MonthlyAvailability {\n    - referenceMonth: YearMonth\n    - preferredDays: EnumSet&lt;DayOfWeek&gt;\n    - weeklyFrequency: int\n    - submittedOn: LocalDate\n    - snapshot: boolean\n    - snapshotCapturedOn: LocalDate\n    + MonthlyAvailability(referenceMonth: YearMonth, preferredDays: Set&lt;DayOfWeek&gt;,\n                          weeklyFrequency: int, submittedOn: LocalDate,\n                          snapshot: boolean, snapshotCapturedOn: LocalDate)\n    + createSnapshot(capturedOn: LocalDate): MonthlyAvailability\n    + resolveAvailableDates(): List&lt;LocalDate&gt;\n    + validateWindow(today: LocalDate)\n    + ensureConsistency()\n    + getPreferredDays(): EnumSet&lt;DayOfWeek&gt;\n    + getWeeklyFrequency(): int\n    + getReferenceMonth(): YearMonth\n    + getSubmittedOn(): LocalDate\n    + isSnapshot(): boolean\n    + getSnapshotCapturedOn(): LocalDate\n  }\n\n  class MonthlyVisitPlan {\n    - targetMonth: YearMonth\n    - phase: PlanningPhase\n    - availabilityWindowClosedOn: LocalDate\n    - plannedVisits: List&lt;PlannedVisit&gt;\n    - availabilitySnapshots: Map&lt;String, MonthlyAvailability&gt;\n    + MonthlyVisitPlan(targetMonth: YearMonth)\n    + MonthlyVisitPlan(targetMonth: YearMonth, phase: PlanningPhase,\n                       availabilityWindowClosedOn: LocalDate,\n                       plannedVisits: List&lt;PlannedVisit&gt;,\n                       availabilitySnapshot: Map&lt;String, MonthlyAvailability&gt;)\n    + getTargetMonth(): YearMonth\n    + setPhase(phase: PlanningPhase)\n    + setAvailabilityWindowClosedOn(date: LocalDate)\n    + getPlannedVisits(): List&lt;PlannedVisit&gt;\n    + setPlannedVisits(plannedVisits: List&lt;PlannedVisit&gt;)\n    + getAvailabilitySnapshots(): Map&lt;String, MonthlyAvailability&gt;\n    + setAvailabilitySnapshots(snapshots: Map&lt;String, MonthlyAvailability&gt;)\n    + recordAvailabilitySnapshot(volunteerId: String, availability: MonthlyAvailability)\n    + removeAvailabilitySnapshot(volunteerId: String)\n    + addPlannedVisit(plannedVisit: PlannedVisit)\n    + removePlannedVisit(plannedVisit: PlannedVisit)\n    + replacePlannedVisits(newPlannedVisits: List&lt;PlannedVisit&gt;)\n    + removeVisitsByVisitType(visitTypeId: String): boolean\n    + removeVisitsByVisitTypes(visitTypeIds: Iterable&lt;String&gt;): boolean\n    + removeVolunteerAssignments(volunteerId: String): boolean\n    + findVisitById(visitId: String): Optional&lt;PlannedVisit&gt;\n  }\n\n  class SystemSettings {\n    - territorialScope: String\n    - MaxPeoplePerSubscription: int\n    - excludedDates: List&lt;LocalDate&gt;\n    - activePlanningMonth: YearMonth\n    - planningPhase: PlanningPhase\n    - lastAvailabilityWindowClosure: LocalDate\n    + SystemSettings(territorialScope: String, maxPeoplePerSubscription: int,\n                     excludedDates: List&lt;LocalDate&gt;, activePlanningMonth: YearMonth,\n                     planningPhase: PlanningPhase, lastAvailabilityWindowClosure: LocalDate)\n    + getTerritorialScope(): String\n    + setTerritorialScope(territorialScope: String)\n    + getMaxPeoplePerSubscription(): int\n    + setMaxPeoplePerSubscription(max: int)\n    + getExcludedDates(): List&lt;LocalDate&gt;\n    + setExcludedDates(excludedDates: List&lt;LocalDate&gt;)\n    + getActivePlanningMonth(): YearMonth\n    + setActivePlanningMonth(month: YearMonth)\n    + getPlanningPhase(): PlanningPhase\n    + setPlanningPhase(planningPhase: PlanningPhase)\n    + getLastAvailabilityWindowClosure(): LocalDate\n    + setLastAvailabilityWindowClosure(date: LocalDate)\n  }\n\n  enum VisitState {\n    PROPOSTA\n    COMPLETA\n    CONFERMATA\n    CANCELLATA\n    EFFETTUATA\n  }\n\n  enum VisitStatus {\n    PROPOSED\n    CONFIRMED\n    CANCELLED\n  }\n\n  enum PlanningPhase {\n    AVAILABILITY_COLLECTION_OPEN\n    AVAILABILITY_COLLECTION_CLOSED\n    CATALOG_MANAGEMENT\n    PLAN_GENERATED\n    ASSIGNMENT\n    REVIEW\n    READY_FOR_NEXT_CYCLE\n  }\n}\n\npackage \&quot;DTO\&quot; {\n  class PlaceDTO {\n    - title: String\n    - description: String\n    - location: String\n    + PlaceDTO(title: String, description: String, location: String)\n    + getTitle(): String\n    + getDescription(): String\n    + getLocation(): String\n  }\n\n  class VisitTypeDTO {\n    - id: String\n    - title: String\n    - daySummary: String\n    - startTime: String\n    - endTime: String\n    - durationMinutes: int\n    - ticketRequired: boolean\n    - minParticipants: int\n    - maxParticipants: int\n    - placeID: String\n    - state: VisitState\n    + VisitTypeDTO(id: String, title: String, daySummary: String,\n                   startTime: String, endTime: String, durationMinutes: int,\n                   ticketRequired: boolean, minParticipants: int, maxParticipants: int,\n                   placeID: String, state: VisitState)\n    + getId(): String\n    + getTitle(): String\n    + getDaySummary(): String\n    + getStartTime(): String\n    + getendTime(): String\n    + getDurationMinutes(): int\n    + isTicketRequired(): boolean\n    + getMinParticipants(): int\n    + getMaxParticipants(): int\n    + getPlaceID(): String\n    + getState(): VisitState\n  }\n\n  class VolunteerAvailabilityDTO {\n    - referenceMonth: YearMonth\n    - preferredDays: List&lt;DayOfWeek&gt;\n    - weeklyFrequency: int\n    - submittedOn: LocalDate\n    + VolunteerAvailabilityDTO(referenceMonth: YearMonth, preferredDays: List&lt;DayOfWeek&gt;,\n                               weeklyFrequency: int, submittedOn: LocalDate)\n    + getReferenceMonth(): YearMonth\n    + getPreferredDays(): List&lt;DayOfWeek&gt;\n    + getWeeklyFrequency(): int\n    + getSubmittedOn(): LocalDate\n  }\n\n  class AssignedShiftDTO {\n    - month: YearMonth\n    - date: LocalDate\n    - visitTypeId: String\n    - slot: TimeSlot\n    + AssignedShiftDTO(month: YearMonth, date: LocalDate, visitTypeId: String, slot: TimeSlot)\n    + getMonth(): YearMonth\n    + getDate(): LocalDate\n    + getVisitTypeId(): String\n    + getSlot(): TimeSlot\n  }\n\n  class VolunteerDTO {\n    - nickname: String\n    - password: String\n    - firstAccessPending: boolean\n    - visitTypeTitles: List&lt;String&gt;\n    - availabilities: List&lt;VolunteerAvailabilityDTO&gt;\n    - scheduledShifts: List&lt;AssignedShiftDTO&gt;\n    + VolunteerDTO(nickname: String, password: String, firstAccessPending: boolean,\n                   visitTypeTitles: List&lt;String&gt;, availabilities: List&lt;VolunteerAvailabilityDTO&gt;,\n                   scheduledShifts: List&lt;AssignedShiftDTO&gt;)\n    + getNickname(): String\n    + getPassword(): String\n    + isFirstAccessPending(): boolean\n    + getVisitTypeTitles(): List&lt;String&gt;\n    + getAvailabilities(): List&lt;VolunteerAvailabilityDTO&gt;\n    + getScheduledShifts(): List&lt;AssignedShiftDTO&gt;\n  }\n\n  class PlanAvailabilityDTO {\n    - volunteerNickname: String\n    - referenceMonth: YearMonth\n    - preferredDays: List&lt;DayOfWeek&gt;\n    - weeklyFrequency: int\n    - submittedOn: LocalDate\n    - snapshotCapturedOn: LocalDate\n    + PlanAvailabilityDTO(volunteerNickname: String, referenceMonth: YearMonth,\n                          preferredDays: List&lt;DayOfWeek&gt;, weeklyFrequency: int,\n                          submittedOn: LocalDate, snapshotCapturedOn: LocalDate)\n    + getVolunteerNickname(): String\n    + getReferenceMonth(): YearMonth\n    + getPreferredDays(): List&lt;DayOfWeek&gt;\n    + getWeeklyFrequency(): int\n    + getSubmittedOn(): LocalDate\n    + getSnapshotCapturedOn(): LocalDate\n  }\n\n  class PlannedVisitDTO {\n    - month: YearMonth\n    - date: LocalDate\n    - dayOfWeek: DayOfWeek\n    - startTime: LocalTime\n    - durationMinutes: long\n    - visitTypeId: String\n    - visitTitle: String\n    - proposable: boolean\n    - assignedVolunteers: List&lt;String&gt;\n    + PlannedVisitDTO(month: YearMonth, date: LocalDate, dayOfWeek: DayOfWeek,\n                      startTime: LocalTime, durationMinutes: long, visitTypeId: String,\n                      visitTitle: String, proposable: boolean, assignedVolunteers: List&lt;String&gt;)\n    + getMonth(): YearMonth\n    + getDate(): LocalDate\n    + getDayOfWeek(): DayOfWeek\n    + getStartTime(): LocalTime\n    + getDurationMinutes(): long\n    + getVisitTypeId(): String\n    + getVisitTitle(): String\n    + isProposable(): boolean\n    + getAssignedVolunteers(): List&lt;String&gt;\n  }\n\n  class MonthlyPlanDTO {\n    - targetMonth: YearMonth\n    - phase: PlanningPhase\n    - availabilityWindowClosedOn: LocalDate\n    - plannedVisits: List&lt;PlannedVisitDTO&gt;\n    - availabilitySnapshots: List&lt;PlanAvailabilityDTO&gt;\n    + MonthlyPlanDTO(targetMonth: YearMonth, phase: PlanningPhase,\n                     availabilityWindowClosedOn: LocalDate, plannedVisits: List&lt;PlannedVisitDTO&gt;,\n                     availabilitySnapshots: List&lt;PlanAvailabilityDTO&gt;)\n    + getTargetMonth(): YearMonth\n    + getPhase(): PlanningPhase\n    + getAvailabilityWindowClosedOn(): LocalDate\n    + getPlannedVisits(): List&lt;PlannedVisitDTO&gt;\n    + getAvailabilitySnapshots(): List&lt;PlanAvailabilityDTO&gt;\n  }\n\n  class VisitBookingDTO {\n    - code: String\n    - beneficiaryName: String\n    - participants: int\n    - notes: String\n    - visitDate: LocalDate\n    - visitTitle: String\n    - status: VisitStatus\n    + VisitBookingDTO(code: String, beneficiaryName: String, participants: int,\n                      notes: String, visitDate: LocalDate, visitTitle: String, status: VisitStatus)\n    + getCode(): String\n    + getBeneficiaryName(): String\n    + getParticipants(): int\n    + getNotes(): String\n    + getVisitDate(): LocalDate\n    + getVisitTitle(): String\n    + getStatus(): VisitStatus\n  }\n\n  class VisitOccurrenceDTO {\n    - id: String\n    - month: YearMonth\n    - date: LocalDate\n    - startTime: LocalTime\n    - title: String\n    - description: String\n    - meetingPoint: String\n    - ticketRequired: boolean\n    - minParticipants: int\n    - maxParticipants: int\n    - bookedParticipants: int\n    - status: VisitStatus\n    - visitTypeId: String\n    - bookings: List&lt;VisitBookingDTO&gt;\n    + VisitOccurrenceDTO(id: String, month: YearMonth, date: LocalDate, startTime: LocalTime,\n                         title: String, description: String, meetingPoint: String,\n                         ticketRequired: boolean, minParticipants: int, maxParticipants: int,\n                         bookedParticipants: int, status: VisitStatus, visitTypeId: String,\n                         bookings: List&lt;VisitBookingDTO&gt;)\n    + getId(): String\n    + getMonth(): YearMonth\n    + getDate(): LocalDate\n    + getStartTime(): LocalTime\n    + getTitle(): String\n    + getDescription(): String\n    + getMeetingPoint(): String\n    + isTicketRequired(): boolean\n    + getMinParticipants(): int\n    + getMaxParticipants(): int\n    + getBookedParticipants(): int\n    + getStatus(): VisitStatus\n    + getVisitTypeId(): String\n    + getBookings(): List&lt;VisitBookingDTO&gt;\n  }\n}\n\npackage \&quot;repository\&quot; {\n  interface VolunteerRepository {\n    + findByNickname(nickname: String): Optional&lt;Volunteer&gt;\n    + findAll(): List&lt;Volunteer&gt;\n    + save(volunteer: Volunteer)\n    + deleteByNickname(nickname: String)\n    + exist(): boolean\n  }\n\n  class JSONVolunteerRepository {\n    - file: Path\n    - cache: Map&lt;String, Volunteer&gt;\n    - planRepository: MonthlyVisitPlanRepository\n    + JSONVolunteerRepository(file: Path)\n    + JSONVolunteerRepository(file: Path, planRepository: MonthlyVisitPlanRepository)\n    + findByNickname(nickname: String): Optional&lt;Volunteer&gt;\n    + findAll(): List&lt;Volunteer&gt;\n    + save(volunteer: Volunteer)\n    + deleteByNickname(nickname: String)\n    + exist(): boolean\n  }\n\n  interface PlaceRepository {\n    + findById(id: String): Optional&lt;Place&gt;\n    + findAll(): List&lt;Place&gt;\n    + save(place: Place)\n    + deleteById(id: String)\n  }\n\n  class JSONPlaceRepository {\n    - file: Path\n    - cache: Map&lt;String, Place&gt;\n    + JSONPlaceRepository(file: Path)\n    + findById(id: String): Optional&lt;Place&gt;\n    + findAll(): List&lt;Place&gt;\n    + save(place: Place)\n    + deleteById(id: String)\n  }\n\n  interface VisitTypeRepository {\n    + findById(id: String): Optional&lt;VisitType&gt;\n    + findByPlace(placeId: String): List&lt;VisitType&gt;\n    + findAll(): List&lt;VisitType&gt;\n    + save(visitType: VisitType)\n    + deleteById(id: String)\n  }\n\n  class JSONVisitTypeRepository {\n    - file: Path\n    - cache: Map&lt;String, VisitType&gt;\n    + JSONVisitTypeRepository(file: Path)\n    + findById(id: String): Optional&lt;VisitType&gt;\n    + findByPlace(placeId: String): List&lt;VisitType&gt;\n    + findAll(): List&lt;VisitType&gt;\n    + save(visitType: VisitType)\n    + deleteById(id: String)\n  }\n\n  interface ConfiguratorRepository {\n    + save(configurator: Configurator)\n    + load(): Optional&lt;Map&lt;String, Configurator&gt;&gt;\n    + deleteByNickname(nickname: String)\n  }\n\n  class JSONConfiguratorRepository {\n    - file: Path\n    - cache: Map&lt;String, Configurator&gt;\n    + JSONConfiguratorRepository(file: Path)\n    + save(configurator: Configurator)\n    + load(): Optional&lt;Map&lt;String, Configurator&gt;&gt;\n    + deleteByNickname(nickname: String)\n  }\n\n  interface SettingsRepository {\n    + save(settings: SystemSettings)\n    + load(): Optional&lt;SystemSettings&gt;\n  }\n\n  class JSONSettingsRepository {\n    - file: Path\n    - cache: SystemSettings\n    + JSONSettingsRepository(file: Path)\n    + save(settings: SystemSettings)\n    + load(): Optional&lt;SystemSettings&gt;\n  }\n\n  interface MonthlyVisitPlanRepository {\n    + save(plan: MonthlyVisitPlan)\n    + findByMonth(month: YearMonth): Optional&lt;MonthlyVisitPlan&gt;\n    + findAll(): List&lt;MonthlyVisitPlan&gt;\n    + deleteByMonth(month: YearMonth)\n    + removeVisitsByVisitType(visitTypeId: String)\n    + removeVolunteerAssignments(nickname: String)\n  }\n\n  class JSONMonthlyVisitPlanRepository {\n    - file: Path\n    - cache: Map&lt;String, MonthlyVisitPlan&gt;\n    + JSONMonthlyVisitPlanRepository(file: Path)\n    + save(plan: MonthlyVisitPlan)\n    + findByMonth(month: YearMonth): Optional&lt;MonthlyVisitPlan&gt;\n    + findAll(): List&lt;MonthlyVisitPlan&gt;\n    + deleteByMonth(month: YearMonth)\n    + removeVisitsByVisitType(visitTypeId: String)\n    + removeVolunteerAssignments(nickname: String)\n  }\n\n  interface BeneficiaryRepository {\n    + findByUsername(username: String): Optional&lt;Beneficiary&gt;\n    + save(beneficiary: Beneficiary)\n    + findAll(): List&lt;Beneficiary&gt;\n  }\n\n  class JSONBeneficiaryRepository {\n    - file: Path\n    - cache: Map&lt;String, Beneficiary&gt;\n    + JSONBeneficiaryRepository(file: Path)\n    + findByUsername(username: String): Optional&lt;Beneficiary&gt;\n    + save(beneficiary: Beneficiary)\n    + findAll(): List&lt;Beneficiary&gt;\n  }\n\n  class ProvisionedCredentialStore {\n    - configurators: Map&lt;String, String&gt;\n    - volunteers: Map&lt;String, String&gt;\n    + ProvisionedCredentialStore()\n    + getConfigurators(): Map&lt;String, String&gt;\n    + getVolunteers(): Map&lt;String, String&gt;\n  }\n\n  interface ProvisionedCredentialsRepository {\n    + findConfiguratorPassword(nickname: String): Optional&lt;String&gt;\n    + findVolunteerPassword(nickname: String): Optional&lt;String&gt;\n    + registerConfiguratorCredential(nickname: String, password: String)\n    + registerVolunteerCredential(nickname: String, password: String)\n    + consumeConfiguratorCredential(nickname: String)\n    + consumeVolunteerCredential(nickname: String)\n    + hasConfiguratorCredential(nickname: String): boolean\n    + hasVolunteerCredential(nickname: String): boolean\n    + hasAnyConfiguratorCredential(): boolean\n  }\n\n  class JSONProvisionedCredentialsRepository {\n    - file: Path\n    - store: ProvisionedCredentialStore\n    + JSONProvisionedCredentialsRepository(file: Path)\n    + findConfiguratorPassword(nickname: String): Optional&lt;String&gt;\n    + findVolunteerPassword(nickname: String): Optional&lt;String&gt;\n    + registerConfiguratorCredential(nickname: String, password: String)\n    + registerVolunteerCredential(nickname: String, password: String)\n    + consumeConfiguratorCredential(nickname: String)\n    + consumeVolunteerCredential(nickname: String)\n    + hasConfiguratorCredential(nickname: String): boolean\n    + hasVolunteerCredential(nickname: String): boolean\n    + hasAnyConfiguratorCredential(): boolean\n  }\n}\n\npackage \&quot;service\&quot; {\n  interface LoginService {\n    + isFirstAccessPending(nickname: String): boolean\n    + verifyDefaultCredentials(nickname: String, password: String)\n    + setPersonalCredentials(currentNickname: String, newNickname: String, password: String)\n    + verifyLogin(nickname: String, password: String): boolean\n  }\n\n  interface VolunteerService {\n    + submitAvailability(nickname: String, availability: MonthlyAvailability, date: LocalDate)\n    + loadAvailability(nickname: String, month: YearMonth): Optional&lt;MonthlyAvailability&gt;\n    + loadSchedule(nickname: String, month: YearMonth): List&lt;AssignedShift&gt;\n    + assignShifts(nickname: String, month: YearMonth, shifts: List&lt;AssignedShift&gt;)\n    + snapshotAvailabilities(month: YearMonth, capturedOn: LocalDate): Map&lt;String, MonthlyAvailability&gt;\n    + removeVolunteerAccount(nickname: String)\n    + loadConfirmedGuidedVisits(nickname: String, month: YearMonth): List&lt;VisitOccurrenceDTO&gt;\n  }\n\n  class VolunteerServiceImp {\n    - volunteerRepository: VolunteerRepository\n    - settingsRepository: SettingsRepository\n    - monthlyVisitPlanRepository: MonthlyVisitPlanRepository\n    - visitTypeRepository: VisitTypeRepository\n    - provisionedCredentialsRepository: ProvisionedCredentialsRepository\n    - defaultCredentialsValidated: Set&lt;String&gt;\n    + VolunteerServiceImp(volunteerRepository: VolunteerRepository,\n                          settingsRepository: SettingsRepository,\n                          monthlyVisitPlanRepository: MonthlyVisitPlanRepository,\n                          visitTypeRepository: VisitTypeRepository,\n                          provisionedCredentialsRepository: ProvisionedCredentialsRepository)\n    + submitAvailability(nickname: String, availability: MonthlyAvailability, today: LocalDate)\n    + loadAvailability(nickname: String, month: YearMonth): Optional&lt;MonthlyAvailability&gt;\n    + loadSchedule(nickname: String, month: YearMonth): List&lt;AssignedShift&gt;\n    + assignShifts(nickname: String, month: YearMonth, shifts: List&lt;AssignedShift&gt;)\n    + snapshotAvailabilities(month: YearMonth, capturedOn: LocalDate): Map&lt;String, MonthlyAvailability&gt;\n    + removeVolunteerAccount(nickname: String)\n    + loadConfirmedGuidedVisits(nickname: String, month: YearMonth): List&lt;VisitOccurrenceDTO&gt;\n    + isFirstAccessPending(nickname: String): boolean\n    + verifyDefaultCredentials(nickname: String, password: String)\n    + setPersonalCredentials(currentNickname: String, newNickname: String, password: String)\n    + verifyLogin(nickname: String, password: String): boolean\n  }\n\n  interface ConfiguratorService {\n    + setTerritorialScope(scope: String)\n    + setMaxPeoplePerSubscription(max: int)\n    + addPlace(name: String, description: String, location: String): String\n    + addVisitType(placeID: String, title: String, description: String, meetLocation: String,\n                   schedules: List&lt;TimeSlot&gt;, ticketRequired: boolean, minParticipants: int,\n                   maxParticipants: int, validFrom: LocalDate, validTo: LocalDate): String\n    + addVolunteer(nickname: String, defaultPassword: String)\n    + linkVOlunteerToVisit(nickname: String, visitTypeId: String)\n    + listPlace(): List&lt;PlaceDTO&gt;\n    + listVisitTypeByPlace(placeId: String): List&lt;VisitTypeDTO&gt;\n    + listVisitType(): List&lt;VisitTypeDTO&gt;\n    + listVolunteerWVisitType(): List&lt;VolunteerDTO&gt;\n    + setBlackoutDates(excludedDates: List&lt;LocalDate&gt;)\n    + closeAvailabilityWindow(today: LocalDate)\n    + applyCatalogChange(change: Runnable)\n    + generateMonthlyPlan(targetMonth: YearMonth): MonthlyPlanDTO\n    + getMonthlyPlanDetails(month: YearMonth): MonthlyPlanDTO\n    + assignVolunteerToPlannedVisit(month: YearMonth, date: LocalDate, slot: TimeSlot,\n                                    visitTypeId: String, volunteerNickname: String)\n    + removePlannedVisit(month: YearMonth, date: LocalDate, slot: TimeSlot, visitTypeId: String)\n    + removePlace(placeID: String)\n    + removeVisitType(visitTypeId: String)\n    + removeVolunteer(nickname: String)\n    + reopenAvailabilityWindow(today: LocalDate)\n    + registerConfigurator(nickname: String, password: String)\n    + listConfigurators(): List&lt;String&gt;\n    + hasPendingConfiguratorSeeds(): boolean\n  }\n\n  class ConfiguratorServiceImp {\n    - placeRepository: PlaceRepository\n    - visitTypeRepository: VisitTypeRepository\n    - volunteerRepository: VolunteerRepository\n    - settingsRepository: SettingsRepository\n    - monthlyVisitPlanRepository: MonthlyVisitPlanRepository\n    - configuratorRepository: ConfiguratorRepository\n    - provisionedCredentialsRepository: ProvisionedCredentialsRepository\n    - volunteerService: VolunteerService\n    - defaultCredentialsValidated: Set&lt;String&gt;\n    + ConfiguratorServiceImp(placeRepository: PlaceRepository,\n                             visitTypeRepository: VisitTypeRepository,\n                             volunteerRepository: VolunteerRepository,\n                             settingsRepository: SettingsRepository,\n                             monthlyVisitPlanRepository: MonthlyVisitPlanRepository,\n                             configuratorRepository: ConfiguratorRepository,\