        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam packageStyle rectangle\nhide empty members\n\npackage \&quot;it.unibs.ingsw24_25.model\&quot; {\n  class AssignedShift\n  class Beneficiary\n  class Configurator\n  class Place\n  class VisitType\n  class PlannedVisit\n  class VisitBooking\n  class MonthlyVisitPlan\n  class MonthlyAvailability\n  class Volunteer\n  class SystemSettings\n  class TimeSlot\n  interface VisitStateBehavior\n  class PropostaState\n  class CompletaState\n  class ConfermataState\n  class CancellataState\n  class EffettuataState\n  enum VisitState\n  enum VisitStatus\n  enum PlanningPhase\n}\n\npackage \&quot;it.unibs.ingsw24_25.DTO\&quot; {\n  class AssignedShiftDTO\n  class MonthlyPlanDTO\n  class PlaceDTO\n  class PlanAvailabilityDTO\n  class PlannedVisitDTO\n  class VisitBookingDTO\n  class VisitOccurrenceDTO\n  class VisitTypeDTO\n  class VolunteerAvailabilityDTO\n  class VolunteerDTO\n}\n\npackage \&quot;it.unibs.ingsw24_25.util\&quot; {\n  class DTOMapper\n  class JSONSupport\n  class AvailabilitySubmissionPolicy\n  interface AvailabilitySubmissionStrategy\n  class StandardAvailabilitySubmissionStrategy\n  class ExcludedDatePolicy\n  class PlanningWindowPolicy\n}\n\npackage \&quot;it.unibs.ingsw24_25.repository\&quot; {\n  interface PlaceRepository\n  interface VisitTypeRepository\n  interface VolunteerRepository\n  interface BeneficiaryRepository\n  interface ConfiguratorRepository\n  interface SettingsRepository\n  interface MonthlyVisitPlanRepository\n  interface ProvisionedCredentialsRepository\n  class JSONPlaceRepository\n  class JSONVisitTypeRepository\n  class JSONVolunteerRepository\n  class JSONBeneficiaryRepository\n  class JSONConfiguratorRepository\n  class JSONSettingsRepository\n  class JSONMonthlyVisitPlanRepository\n  class JSONProvisionedCredentialsRepository\n  class ProvisionedCredentialStore\n}\n\npackage \&quot;it.unibs.ingsw24_25.service\&quot; {\n  interface LoginSer