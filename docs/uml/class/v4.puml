    + getPreferredDays(): List<DayOfWeek>
    + getWeeklyFrequency(): int
    + getSubmittedOn(): LocalDate
  }

  class AssignedShiftDTO {
    - month: YearMonth
    - date: LocalDate
    - visitTypeId: String
    - slot: TimeSlot
    + AssignedShiftDTO(month: YearMonth, date: LocalDate, visitTypeId: String, slot: TimeSlot)
    + getMonth(): YearMonth
    + getDate(): LocalDate
    + getVisitTypeId(): String
    + getSlot(): TimeSlot
  }

  class VolunteerDTO {
    - nickname: String
    - password: String
    - firstAccessPending: boolean
    - visitTypeTitles: List<String>
    - availabilities: List<VolunteerAvailabilityDTO>
    - scheduledShifts: List<AssignedShiftDTO>
    + VolunteerDTO(nickname: String, password: String, firstAccessPending: boolean,
                   visitTypeTitles: List<String>, availabilities: List<VolunteerAvailabilityDTO>,
                   scheduledShifts: List<AssignedShiftDTO>)
    + getNickname(): String
    + getPassword(): String
    + isFirstAccessPending(): boolean
    + getVisitTypeTitles(): List<String>
    + getAvailabilities(): List<VolunteerAvailabilityDTO>
    + getScheduledShifts(): List<AssignedShiftDTO>
  }

  class PlanAvailabilityDTO {
    - volunteerNickname: String
    - referenceMonth: YearMonth
    - preferredDays: List<DayOfWeek>
    - weeklyFrequency: int
    - submittedOn: LocalDate
    - snapshotCapturedOn: LocalDate
    + PlanAvailabilityDTO(volunteerNickname: String, referenceMonth: YearMonth,
                          preferredDays: List<DayOfWeek>, weeklyFrequency: int,
                          submittedOn: LocalDate, snapshotCapturedOn: LocalDate)
    + getVolunteerNickname(): String
    + getReferenceMonth(): YearMonth
    + getPreferredDays(): List<DayOfWeek>
    + getWeeklyFrequency(): int
    + getSubmittedOn(): LocalDate
    + getSnapshotCapturedOn(): LocalDate
  }

  class PlannedVisitDTO {
    - month: YearMonth
    - date: LocalDate
    - dayOfWeek: DayOfWeek
    - startTime: LocalTime
    - durationMinutes: long
    - visitTypeId: String
    - visitTitle: String
    - proposable: boolean
    - assignedVolunteers: List<String>
    + PlannedVisitDTO(month: YearMonth, date: LocalDate, dayOfWeek: DayOfWeek,
                      startTime: LocalTime, durationMinutes: long, visitTypeId: String,
                      visitTitle: String, proposable: boolean, assignedVolunteers: List<String>)
    + getMonth(): YearMonth
