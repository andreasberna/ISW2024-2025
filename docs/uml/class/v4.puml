package "repository" {
  interface VolunteerRepository {
    + findByNickname(nickname: String): Optional<Volunteer>
    + findAll(): List<Volunteer>
    + save(volunteer: Volunteer)
    + deleteByNickname(nickname: String)
    + exist(): boolean
  }

  class JSONVolunteerRepository {
    - file: Path
    - cache: Map<String, Volunteer>
    - planRepository: MonthlyVisitPlanRepository
    + JSONVolunteerRepository(file: Path)
    + JSONVolunteerRepository(file: Path, planRepository: MonthlyVisitPlanRepository)
    + findByNickname(nickname: String): Optional<Volunteer>
    + findAll(): List<Volunteer>
    + save(volunteer: Volunteer)
    + deleteByNickname(nickname: String)
    + exist(): boolean
  }

  interface PlaceRepository {
    + findById(id: String): Optional<Place>
    + findAll(): List<Place>
    + save(place: Place)
    + deleteById(id: String)
  }

  class JSONPlaceRepository {
    - file: Path
    - cache: Map<String, Place>
    + JSONPlaceRepository(file: Path)
    + findById(id: String): Optional<Place>
    + findAll(): List<Place>
    + save(place: Place)
    + deleteById(id: String)
  }

  interface VisitTypeRepository {
    + findById(id: String): Optional<VisitType>
    + findByPlace(placeId: String): List<VisitType>
    + findAll(): List<VisitType>
    + save(visitType: VisitType)
    + deleteById(id: String)
  }

  class JSONVisitTypeRepository {
    - file: Path
    - cache: Map<String, VisitType>
    + JSONVisitTypeRepository(file: Path)
    + findById(id: String): Optional<VisitType>
    + findByPlace(placeId: String): List<VisitType>
    + findAll(): List<VisitType>
    + save(visitType: VisitType)
    + deleteById(id: String)
  }

  interface ConfiguratorRepository {
    + save(configurator: Configurator)
    + load(): Optional<Map<String, Configurator>>
    + deleteByNickname(nickname: String)
  }

  class JSONConfiguratorRepository {
    - file: Path
    - cache: Map<String, Configurator>
    + JSONConfiguratorRepository(file: Path)
    + save(configurator: Configurator)
    + load(): Optional<Map<String, Configurator>>
    + deleteByNickname(nickname: String)
  }

  interface SettingsRepository {
    + save(settings: SystemSettings)
    + load(): Optional<SystemSettings>
  }

  class JSONSettingsRepository {
    - file: Path
    - cache: SystemSettings
    + JSONSettingsRepository(file: Path)
    + save(settings: SystemSettings)
    + load(): Optional<SystemSettings>
  }

  interface MonthlyVisitPlanRepository {
    + save(plan: MonthlyVisitPlan)
    + findByMonth(month: YearMonth): Optional<MonthlyVisitPlan>
    + findAll(): List<MonthlyVisitPlan>
    + deleteByMonth(month: YearMonth)
    + removeVisitsByVisitType(visitTypeId: String)
    + removeVolunteerAssignments(nickname: String)
  }

  class JSONMonthlyVisitPlanRepository {
    - file: Path
    - cache: Map<String, MonthlyVisitPlan>
    + JSONMonthlyVisitPlanRepository(file: Path)
    + save(plan: MonthlyVisitPlan)
    + findByMonth(month: YearMonth): Optional<MonthlyVisitPlan>
    + findAll(): List<MonthlyVisitPlan>
    + deleteByMonth(month: YearMonth)
    + removeVisitsByVisitType(visitTypeId: String)
    + removeVolunteerAssignments(nickname: String)
  }

  interface BeneficiaryRepository {
    + findByUsername(username: String): Optional<Beneficiary>
    + save(beneficiary: Beneficiary)
    + findAll(): List<Beneficiary>
  }

  class JSONBeneficiaryRepository {
    - file: Path
    - cache: Map<String, Beneficiary>
    + JSONBeneficiaryRepository(file: Path)
    + findByUsername(username: String): Optional<Beneficiary>
    + save(beneficiary: Beneficiary)
    + findAll(): List<Beneficiary>
  }

  class ProvisionedCredentialStore {
    - configurators: Map<String, String>
    - volunteers: Map<String, String>
    + ProvisionedCredentialStore()
    + getConfigurators(): Map<String, String>
    + getVolunteers(): Map<String, String>
  }

  interface ProvisionedCredentialsRepository {
    + findConfiguratorPassword(nickname: String): Optional<String>
    + findVolunteerPassword(nickname: String): Optional<String>
    + registerConfiguratorCredential(nickname: String, password: String)
    + registerVolunteerCredential(nickname: String, password: String)
    + consumeConfiguratorCredential(nickname: String)
    + consumeVolunteerCredential(nickname: String)
    + hasConfiguratorCredential(nickname: String): boolean
    + hasVolunteerCredential(nickname: String): boolean
    + hasAnyConfiguratorCredential(): boolean
  }

  class JSONProvisionedCredentialsRepository {
    - file: Path
    - store: ProvisionedCredentialStore
    + JSONProvisionedCredentialsRepository(file: Path)
    + findConfiguratorPassword(nickname: String): Optional<String>
    + findVolunteerPassword(nickname: String): Optional<String>
    + registerConfiguratorCredential(nickname: String, password: String)
    + registerVolunteerCredential(nickname: String, password: String)
    + consumeConfiguratorCredential(nickname: String)
    + consumeVolunteerCredential(nickname: String)
    + hasConfiguratorCredential(nickname: String): boolean
    + hasVolunteerCredential(nickname: String): boolean
    + hasAnyConfiguratorCredential(): boolean
  }
}

package "service" {
  interface LoginService {
    + isFirstAccessPending(nickname: String): boolean
    + verifyDefaultCredentials(nickname: String, password: String)
    + setPersonalCredentials(currentNickname: String, newNickname: String, password: String)
    + verifyLogin(nickname: String, password: String): boolean
  }

  interface VolunteerService {
    + submitAvailability(nickname: String, availability: MonthlyAvailability, date: LocalDate)
    + loadAvailability(nickname: String, month: YearMonth): Optional<MonthlyAvailability>
    + loadSchedule(nickname: String, month: YearMonth): List<AssignedShift>
    + assignShifts(nickname: String, month: YearMonth, shifts: List<AssignedShift>)
    + snapshotAvailabilities(month: YearMonth, capturedOn: LocalDate): Map<String, MonthlyAvailability>
    + removeVolunteerAccount(nickname: String)
    + loadConfirmedGuidedVisits(nickname: String, month: YearMonth): List<VisitOccurrenceDTO>
  }

  class VolunteerServiceImp {
    - volunteerRepository: VolunteerRepository
    - settingsRepository: SettingsRepository
    - monthlyVisitPlanRepository: MonthlyVisitPlanRepository
    - visitTypeRepository: VisitTypeRepository
    - provisionedCredentialsRepository: ProvisionedCredentialsRepository
    - defaultCredentialsValidated: Set<String>
    + VolunteerServiceImp(volunteerRepository: VolunteerRepository,
                          settingsRepository: SettingsRepository,
                          monthlyVisitPlanRepository: MonthlyVisitPlanRepository,
                          visitTypeRepository: VisitTypeRepository,
                          provisionedCredentialsRepository: ProvisionedCredentialsRepository)
    + submitAvailability(nickname: String, availability: MonthlyAvailability, today: LocalDate)
    + loadAvailability(nickname: String, month: YearMonth): Optional<MonthlyAvailability>
    + loadSchedule(nickname: String, month: YearMonth): List<AssignedShift>
    + assignShifts(nickname: String, month: YearMonth, shifts: List<AssignedShift>)
    + snapshotAvailabilities(month: YearMonth, capturedOn: LocalDate): Map<String, MonthlyAvailability>
    + removeVolunteerAccount(nickname: String)
    + loadConfirmedGuidedVisits(nickname: String, month: YearMonth): List<VisitOccurrenceDTO>
    + isFirstAccessPending(nickname: String): boolean
    + verifyDefaultCredentials(nickname: String, password: String)
    + setPersonalCredentials(currentNickname: String, newNickname: String, password: String)
    + verifyLogin(nickname: String, password: String): boolean
  }

  interface ConfiguratorService {
    + setTerritorialScope(scope: String)
    + setMaxPeoplePerSubscription(max: int)
    + addPlace(name: String, description: String, location: String): String
    + addVisitType(placeID: String, title: String, description: String, meetLocation: String,
                   schedules: List<TimeSlot>, ticketRequired: boolean, minParticipants: int,
                   maxParticipants: int, validFrom: LocalDate, validTo: LocalDate): String
    + addVolunteer(nickname: String, defaultPassword: String)
    + linkVOlunteerToVisit(nickname: String, visitTypeId: String)
    + listPlace(): List<PlaceDTO>
    + listVisitTypeByPlace(placeId: String): List<VisitTypeDTO>
    + listVisitType(): List<VisitTypeDTO>
    + listVolunteerWVisitType(): List<VolunteerDTO>
    + setBlackoutDates(excludedDates: List<LocalDate>)
    + closeAvailabilityWindow(today: LocalDate)
    + applyCatalogChange(change: Runnable)
    + generateMonthlyPlan(targetMonth: YearMonth): MonthlyPlanDTO
    + getMonthlyPlanDetails(month: YearMonth): MonthlyPlanDTO
    + assignVolunteerToPlannedVisit(month: YearMonth, date: LocalDate, slot: TimeSlot,
                                    visitTypeId: String, volunteerNickname: String)
    + removePlannedVisit(month: YearMonth, date: LocalDate, slot: TimeSlot, visitTypeId: String)
    + removePlace(placeID: String)
    + removeVisitType(visitTypeId: String)
    + removeVolunteer(nickname: String)
    + reopenAvailabilityWindow(today: LocalDate)
    + registerConfigurator(nickname: String, password: String)
    + listConfigurators(): List<String>
    + hasPendingConfiguratorSeeds(): boolean
  }

  class ConfiguratorServiceImp {
    - placeRepository: PlaceRepository
    - visitTypeRepository: VisitTypeRepository
    - volunteerRepository: VolunteerRepository
    - settingsRepository: SettingsRepository
    - monthlyVisitPlanRepository: MonthlyVisitPlanRepository
    - configuratorRepository: ConfiguratorRepository
    - provisionedCredentialsRepository: ProvisionedCredentialsRepository
    - volunteerService: VolunteerService
    - defaultCredentialsValidated: Set<String>
    + ConfiguratorServiceImp(placeRepository: PlaceRepository,
                             visitTypeRepository: VisitTypeRepository,
                             volunteerRepository: VolunteerRepository,
                             settingsRepository: SettingsRepository,
                             monthlyVisitPlanRepository: MonthlyVisitPlanRepository,
                             configuratorRepository: ConfiguratorRepository,
                             provisionedCredentialsRepository: ProvisionedCredentialsRepository,
                             volunteerService: VolunteerService)
    + setTerritorialScope(scope: String)
    + setMaxPeoplePerSubscription(max: int)
    + addPlace(name: String, description: String, location: String): String
    + addVisitType(placeID: String, title: String, description: String, meetLocation: String,
                   schedules: List<TimeSlot>, ticketRequired: boolean, minParticipants: int,
                   maxParticipants: int, validFrom: LocalDate, validTo: LocalDate): String
    + addVolunteer(nickname: String, defaultPassword: String)
    + linkVOlunteerToVisit(nickname: String, visitTypeId: String)
    + listPlace(): List<PlaceDTO>
    + listVisitTypeByPlace(placeId: String): List<VisitTypeDTO>
    + listVisitType(): List<VisitTypeDTO>
    + listVolunteerWVisitType(): List<VolunteerDTO>
    + setBlackoutDates(excludedDates: List<LocalDate>)
    + closeAvailabilityWindow(today: LocalDate)
    + applyCatalogChange(change: Runnable)
    + generateMonthlyPlan(targetMonth: YearMonth): MonthlyPlanDTO
    + getMonthlyPlanDetails(month: YearMonth): MonthlyPlanDTO
    + assignVolunteerToPlannedVisit(month: YearMonth, date: LocalDate, slot: TimeSlot,
                                    visitTypeId: String, volunteerNickname: String)
    + removePlannedVisit(month: YearMonth, date: LocalDate, slot: TimeSlot, visitTypeId: String)
    + removePlace(placeID: String)
    + removeVisitType(visitTypeId: String)
    + removeVolunteer(nickname: String)
    + reopenAvailabilityWindow(today: LocalDate)
    + registerConfigurator(nickname: String, password: String)
    + listConfigurators(): List<String>
    + hasPendingConfiguratorSeeds(): boolean
    + isFirstAccessPending(nickname: String): boolean
    + verifyDefaultCredentials(nickname: String, password: String)
    + setPersonalCredentials(currentNickname: String, newNickname: String, password: String)
    + verifyLogin(nickname: String, password: String): boolean
  }

  interface BeneficiaryService {
    + register(fullName: String, username: String, password: String)
    + listVisitsByStatus(statuses: VisitStatus[]): List<VisitOccurrenceDTO>
    + bookVisit(username: String, visitId: String, participants: int, notes: String, today: LocalDate): String
    + listBookings(username: String): List<VisitBookingDTO>
    + cancelBooking(username: String, bookingCode: String, today: LocalDate)
  }

  class BeneficiaryServiceImp {
    - beneficiaryRepository: BeneficiaryRepository
    - volunteerRepository: VolunteerRepository
    - monthlyVisitPlanRepository: MonthlyVisitPlanRepository
    - visitTypeRepository: VisitTypeRepository
    - settingsRepository: SettingsRepository
    + BeneficiaryServiceImp(beneficiaryRepository: BeneficiaryRepository,
                             volunteerRepository: VolunteerRepository,
                             monthlyVisitPlanRepository: MonthlyVisitPlanRepository,
                             visitTypeRepository: VisitTypeRepository,
                             settingsRepository: SettingsRepository)
    + register(fullName: String, username: String, password: String)
    + listVisitsByStatus(statuses: VisitStatus[]): List<VisitOccurrenceDTO>
    + bookVisit(username: String, visitId: String, participants: int, notes: String, today: LocalDate): String
    + listBookings(username: String): List<VisitBookingDTO>
    + cancelBooking(username: String, bookingCode: String, today: LocalDate)
    + isFirstAccessPending(nickname: String): boolean
    + verifyDefaultCredentials(nickname: String, password: String)
    + setPersonalCredentials(currentNickname: String, newNickname: String, password: String)
    + verifyLogin(username: String, password: String): boolean
  }
}

package "util" {
  class DTOMapper {
    + placeToDTO(place: Place): PlaceDTO
    + visitTypeToDTO(visitType: VisitType): VisitTypeDTO
    + volunteerToDTO(volunteer: Volunteer): VolunteerDTO
    + planToDTO(plan: MonthlyVisitPlan, visitTypes: List<VisitType>): MonthlyPlanDTO
    + toVisitOccurrenceDTO(plan: MonthlyVisitPlan, visit: PlannedVisit,
                           visitType: VisitType, includeBookings: boolean): VisitOccurrenceDTO
  }

  class JSONSupport {
    + serializeConfigurator(map: Map<String, Configurator>): String
    + deserializeConfigurator(json: String): Map<String, Configurator>
    + serializeVolunteerMap(map: Map<String, Volunteer>): String
    + deserializeVolunteerMap(json: String): Map<String, Volunteer>
    + serializePlaceMap(map: Map<String, Place>): String
    + deserializePlaceMap(json: String): Map<String, Place>
    + serializeVisitTypeMap(map: Map<String, VisitType>): String
    + deserializeVisitTypeMap(json: String): Map<String, VisitType>
    + serializeMonthlyVisitPlanMap(map: Map<String, MonthlyVisitPlan>): String
    + deserializeMonthlyVisitPlanMap(json: String): Map<String, MonthlyVisitPlan>
    + serializeBeneficiaryMap(map: Map<String, Beneficiary>): String
    + deserializeBeneficiaryMap(json: String): Map<String, Beneficiary>
    + serializeSystemSettings(settings: SystemSettings): String
    + deserializeSystemSettings(json: String): SystemSettings
    + serializeProvisionedCredentials(store: ProvisionedCredentialStore): String
    + deserializeProvisionedCredentials(json: String): ProvisionedCredentialStore
  }

  class AvailabilitySubmissionPolicy {
    + isWindowOpen(referenceMonth: YearMonth, today: LocalDate): boolean
    + nextSubmissionMonth(today: LocalDate): YearMonth
  }

  class ExcludedDatePolicy {
    + allowedMonth(referenceDate: LocalDate): YearMonth
  }

  class PlanningWindowPolicy {
    + resolveNextPlanningMonth(today: LocalDate): YearMonth
  }
}

package "cli" {
  class PromptReader {
    - scanner: Scanner
    + PromptReader(scanner: Scanner)
    + readLine(prompt: String): String
    + readInt(prompt: String): int
    + readLocalDate(prompt: String): LocalDate
    + readYesNo(prompt: String): boolean
  }

  class Printer {
    + println(message: String)
    + print(message: String)
    + printSeparator()
  }

  class VolunteerCliSupport {
    - volunteerService: VolunteerService
    - printer: Printer
    - promptReader: PromptReader
    + VolunteerCliSupport(volunteerService: VolunteerService, printer: Printer, promptReader: PromptReader)
    + run()
    + handleAvailability()
    + handleSchedule()
    + handleGuidedVisits()
  }

  class BeneficiaryCommandHandler {
    - beneficiaryService: BeneficiaryService
    - printer: Printer
    - promptReader: PromptReader
    + BeneficiaryCommandHandler(beneficiaryService: BeneficiaryService, printer: Printer, promptReader: PromptReader)
    + run()
    + handleRegistration()
    + handleLogin()
    + handleBooking()
    + handleCancellation()
  }

  class VolunteerCommandHandler {
    - volunteerService: VolunteerService
    - printer: Printer
    - promptReader: PromptReader
    + VolunteerCommandHandler(volunteerService: VolunteerService, printer: Printer, promptReader: PromptReader)
    + run()
    + handleFirstAccess()
    + handleLogin()
  }

  class ConfiguratorCommandHandler {
    - configuratorService: ConfiguratorService
    - volunteerService: VolunteerService
    - printer: Printer
    - promptReader: PromptReader
    + ConfiguratorCommandHandler(configuratorService: ConfiguratorService, volunteerService: VolunteerService,
                                 printer: Printer, promptReader: PromptReader)
    + run()
    + handleFirstAccess()
    + handleLogin()
    + handleCatalogManagement()
    + handlePlanning()
  }

  class FirstAccessSetup {
    - configuratorService: ConfiguratorService
    - volunteerService: VolunteerService
    - printer: Printer
    - promptReader: PromptReader
    + FirstAccessSetup(configuratorService: ConfiguratorService, volunteerService: VolunteerService,
                       printer: Printer, promptReader: PromptReader)
    + run()
  }

  class CommandRouter {
    - beneficiaryHandler: BeneficiaryCommandHandler
    - volunteerHandler: VolunteerCommandHandler
    - configuratorHandler: ConfiguratorCommandHandler
    - printer: Printer
    - promptReader: PromptReader
    + CommandRouter(beneficiaryHandler: BeneficiaryCommandHandler,
                    volunteerHandler: VolunteerCommandHandler,
                    configuratorHandler: ConfiguratorCommandHandler,
                    printer: Printer, promptReader: PromptReader)
    + route()
  }

  class CliApp {
    - commandRouter: CommandRouter
    + CliApp(commandRouter: CommandRouter)
    + run()
  }

  class Main {
    + main(args: String[])
  }
}



