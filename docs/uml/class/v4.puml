@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle
hide circle

package "model" {
  class Configurator {
    - nickname: String
    - password: String
    + Configurator(nickname: String, password: String)
    + getNickname(): String
    + getPassword(): String
    + setNickname(nickname: String)
    + setPassword(password: String)
  }

  class Beneficiary {
    - username: String
    - password: String
    - fullName: String
    + Beneficiary(username: String, password: String, fullName: String)
    + getUsername(): String
    + getPassword(): String
    + getFullName(): String
    + setUsername(username: String)
    + setPassword(password: String)
    + setFullName(fullName: String)
    + passwordMatches(candidate: String): boolean
  }

  class Volunteer {
    - nickname: String
    - password: String
    - personalCredentialsDefined: boolean
    - visitsAttending: List<VisitType>
    - availabilities: Map<YearMonth, MonthlyAvailability>
    - scheduledShifts: Map<YearMonth, List<AssignedShift>>
    - active: boolean
    + Volunteer(nickname: String, password: String)
    + isFirstAccessPending(): boolean
    + setPersonalCredentials(password: String)
    + passwordMatches(candidate: String): boolean
    + addVisit(visit: VisitType)
    + removeVisit(visit: VisitType)
    + getAvailabilities(): Map<YearMonth, MonthlyAvailability>
    + findAvailability(month: YearMonth): Optional<MonthlyAvailability>
    + registerAvailability(availability: MonthlyAvailability)
    + getScheduledShifts(): Map<YearMonth, List<AssignedShift>>
    + getShiftsForMonth(month: YearMonth): List<AssignedShift>
    + assignShifts(month: YearMonth, shifts: List<AssignedShift>)
    + deactivate()
    + activate()
  }

  class Place {
    - placeTitle: String
    - placeDescription: String
    - location: String
    - visits: List<VisitType>
    + Place(placeTitle: String, placeDescription: String, location: String)
    + getPlaceTitle(): String
    + getPlaceDescription(): String
    + getLocation(): String
    + getVisits(): List<VisitType>
    + setVisits(visits: List<VisitType>)
    + addVisit(visit: VisitType)
    + removeVisit(visit: VisitType)
  }

  class TimeSlot {
    - day: DayOfWeek
    - startTime: LocalTime
    - duration: Duration
    + TimeSlot(day: DayOfWeek, startTime: LocalTime, duration: Duration)
    + getDay(): DayOfWeek
    + getStartTime(): LocalTime
    + getDuration(): Duration
    + setDay(day: DayOfWeek)
    + setStartTime(startTime: LocalTime)
    + setDuration(duration: Duration)
  }

  class VisitType {
    - id: String
    - visitTitle: String
    - visitDescription: String
    - visitMeetLocation: String
    - validFrom: LocalDate
    - validTo: LocalDate
    - schedules: List<TimeSlot>
    - ticketRequired: Boolean
    - minParticipants: int
    - maxParticipants: int
    - place: Place
    - guides: List<Volunteer>
    - state: VisitState
    - visitDate: LocalDate
    - enrollmentDeadline: LocalDate
    - enrolled: int
    + VisitType(id: String, visitTitle: String, visitDescription: String, visitMeetLocation: String,
                validFrom: LocalDate, validTo: LocalDate, schedules: List<TimeSlot>,
                ticketRequired: Boolean, minParticipants: int, maxParticipants: int,
                place: Place, guides: List<Volunteer>)
    + addSchedule(timeSlot: TimeSlot)
    + removeSchedule(timeSlot: TimeSlot)
    + addGuide(volunteer: Volunteer)
    + removeGuide(volunteer: Volunteer)
    + addEnrollment(n: int)
    + removeEnrollment(n: int)
    + updateState(today: LocalDate)
    + generateOccurrences(month: YearMonth): List<PlannedVisit>
    + isValidOn(date: LocalDate): boolean
    + getGuides(): List<Volunteer>
    + getSchedules(): List<TimeSlot>
    + setVisitDate(visitDate: LocalDate)
    + setEnrollmentDeadline(enrollmentDeadline: LocalDate)
    + getState(): VisitState
  }

  class VisitBooking {
    - code: String
    - beneficiaryUsername: String
    - beneficiaryName: String
    - participants: int
    - notes: String
    + VisitBooking(code: String, beneficiaryUsername: String, beneficiaryName: String,
                   participants: int, notes: String)
    + getCode(): String
    + getBeneficiaryUsername(): String
    + getBeneficiaryName(): String
    + getParticipants(): int
    + getNotes(): String
  }

  class PlannedVisit {
    - id: String
    - date: LocalDate
    - timeSlot: TimeSlot
    - visitTypeId: String
    - assignedVolunteerIds: List<String>
    - proposable: boolean
    - status: VisitStatus
    - bookings: List<VisitBooking>
    + PlannedVisit(id: String, date: LocalDate, timeSlot: TimeSlot, visitTypeId: String,
                   proposable: boolean, assignedVolunteerIds: List<String>,
                   status: VisitStatus, bookings: List<VisitBooking>)
    + assignVolunteer(volunteerId: String)
    + unassignVolunteer(volunteerId: String): boolean
    + clearAssignements()
    + getStatus(): VisitStatus
    + setStatus(status: VisitStatus)
    + getBookings(): List<VisitBooking>
    + addBooking(booking: VisitBooking)
    + removeBookingByCode(bookingCode: String): boolean
    + getBookedParticipants(): int
    + findBookingByCode(code: String): VisitBooking
  }

  class AssignedShift {
    - date: LocalDate
    - visitTypeId: String
    - slot: TimeSlot
    + AssignedShift(date: LocalDate, visitTypeId: String, slot: TimeSlot)
    + getDate(): LocalDate
    + getVisitTypeId(): String
    + getSlot(): TimeSlot
  }

  class MonthlyAvailability {
    - referenceMonth: YearMonth
    - preferredDays: EnumSet<DayOfWeek>
    - weeklyFrequency: int
    - submittedOn: LocalDate
    - snapshot: boolean
    - snapshotCapturedOn: LocalDate
    + MonthlyAvailability(referenceMonth: YearMonth, preferredDays: Set<DayOfWeek>,
                          weeklyFrequency: int, submittedOn: LocalDate,
                          snapshot: boolean, snapshotCapturedOn: LocalDate)
    + createSnapshot(capturedOn: LocalDate): MonthlyAvailability
    + resolveAvailableDates(): List<LocalDate>
    + validateWindow(today: LocalDate)
    + ensureConsistency()
    + getPreferredDays(): EnumSet<DayOfWeek>
    + getWeeklyFrequency(): int
    + getReferenceMonth(): YearMonth
    + getSubmittedOn(): LocalDate
    + isSnapshot(): boolean
    + getSnapshotCapturedOn(): LocalDate
  }

  class MonthlyVisitPlan {
    - targetMonth: YearMonth
    - phase: PlanningPhase
    - availabilityWindowClosedOn: LocalDate
    - plannedVisits: List<PlannedVisit>
    - availabilitySnapshots: Map<String, MonthlyAvailability>
    + MonthlyVisitPlan(targetMonth: YearMonth)
    + MonthlyVisitPlan(targetMonth: YearMonth, phase: PlanningPhase,
                       availabilityWindowClosedOn: LocalDate,
                       plannedVisits: List<PlannedVisit>,
                       availabilitySnapshot: Map<String, MonthlyAvailability>)
    + getTargetMonth(): YearMonth
    + setPhase(phase: PlanningPhase)
    + setAvailabilityWindowClosedOn(date: LocalDate)
    + getPlannedVisits(): List<PlannedVisit>
    + setPlannedVisits(plannedVisits: List<PlannedVisit>)
    + getAvailabilitySnapshots(): Map<String, MonthlyAvailability>
    + setAvailabilitySnapshots(snapshots: Map<String, MonthlyAvailability>)
    + recordAvailabilitySnapshot(volunteerId: String, availability: MonthlyAvailability)
    + removeAvailabilitySnapshot(volunteerId: String)
    + addPlannedVisit(plannedVisit: PlannedVisit)
    + removePlannedVisit(plannedVisit: PlannedVisit)
    + replacePlannedVisits(newPlannedVisits: List<PlannedVisit>)
    + removeVisitsByVisitType(visitTypeId: String): boolean
    + removeVisitsByVisitTypes(visitTypeIds: Iterable<String>): boolean
    + removeVolunteerAssignments(volunteerId: String): boolean
    + findVisitById(visitId: String): Optional<PlannedVisit>
  }

  class SystemSettings {
    - territorialScope: String
    - MaxPeoplePerSubscription: int
    - excludedDates: List<LocalDate>
    - activePlanningMonth: YearMonth
    - planningPhase: PlanningPhase
    - lastAvailabilityWindowClosure: LocalDate
    + SystemSettings(territorialScope: String, maxPeoplePerSubscription: int,
                     excludedDates: List<LocalDate>, activePlanningMonth: YearMonth,
                     planningPhase: PlanningPhase, lastAvailabilityWindowClosure: LocalDate)
    + getTerritorialScope(): String
    + setTerritorialScope(territorialScope: String)
    + getMaxPeoplePerSubscription(): int
    + setMaxPeoplePerSubscription(max: int)
    + getExcludedDates(): List<LocalDate>
    + setExcludedDates(excludedDates: List<LocalDate>)
    + getActivePlanningMonth(): YearMonth
    + setActivePlanningMonth(month: YearMonth)
    + getPlanningPhase(): PlanningPhase
    + setPlanningPhase(planningPhase: PlanningPhase)
    + getLastAvailabilityWindowClosure(): LocalDate
    + setLastAvailabilityWindowClosure(date: LocalDate)
  }

  enum VisitState {
    PROPOSTA
    COMPLETA
    CONFERMATA
    CANCELLATA
    EFFETTUATA
  }

  enum VisitStatus {
    PROPOSED
    CONFIRMED
    CANCELLED
  }

  enum PlanningPhase {
    AVAILABILITY_COLLECTION_OPEN
    AVAILABILITY_COLLECTION_CLOSED
    CATALOG_MANAGEMENT
    PLAN_GENERATED
    ASSIGNMENT
    REVIEW
    READY_FOR_NEXT_CYCLE
  }
}

package "DTO" {
  class PlaceDTO {
    - title: String
    - description: String
    - location: String
    + PlaceDTO(title: String, description: String, location: String)
    + getTitle(): String
    + getDescription(): String
    + getLocation(): String
  }

  class VisitTypeDTO {
    - id: String
    - title: String
    - daySummary: String
    - startTime: String
    - endTime: String
    - durationMinutes: int
    - ticketRequired: boolean
    - minParticipants: int
    - maxParticipants: int
    - placeID: String
    - state: VisitState
    + VisitTypeDTO(id: String, title: String, daySummary: String,
                   startTime: String, endTime: String, durationMinutes: int,
                   ticketRequired: boolean, minParticipants: int, maxParticipants: int,
                   placeID: String, state: VisitState)
    + getId(): String
    + getTitle(): String
    + getDaySummary(): String
    + getStartTime(): String
    + getendTime(): String
    + getDurationMinutes(): int
    + isTicketRequired(): boolean
    + getMinParticipants(): int
    + getMaxParticipants(): int
    + getPlaceID(): String
    + getState(): VisitState
  }

  class VolunteerAvailabilityDTO {
    - referenceMonth: YearMonth
    - preferredDays: List<DayOfWeek>
    - weeklyFrequency: int
    - submittedOn: LocalDate
    + VolunteerAvailabilityDTO(referenceMonth: YearMonth, preferredDays: List<DayOfWeek>,
                               weeklyFrequency: int, submittedOn: LocalDate)
