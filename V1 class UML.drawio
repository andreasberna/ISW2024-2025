        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\nskinparam shadowing false\nskinparam packageStyle rectangle\n\npackage \&quot;model\&quot; {\nclass Configurator {\n  - nickname: String\n  - password: String\n  + Configurator(nickname: String, password: String)\n  + getNickname(): String\n  + getPassword(): String\n  + setNickname(nickname: String)\n  + setPassword(password: String)\n}\n\nclass SystemSettings {\n  - territorialScope: String\n  - MaxPeoplePerSubscription: int\n  - excludedDates: List&lt;LocalDate&gt;\n  + SystemSettings(territorialScope: String, maxPeoplePerSubscription: int, excludedDates: List&lt;LocalDate&gt;)\n  + getTerritorialScope(): String\n  + setTerritorialScope(territorialScope: String)\n  + getMaxPeoplePerSubscription(): int\n  + setMaxPeoplePerSubscription(max: int)\n  + getExcludedDates(): List&lt;LocalDate&gt;\n  + setExcludedDates(excludedDates: List&lt;LocalDate&gt;)\n}\n\nclass Volunteer {\n  - nickname: String\n  - visitsAttending: List&lt;VisitType&gt;\n  + Volunteer(nickname: String)\n  + getNickname(): String\n  + setNickname(nickname: String)\n  + getVisitsAttending(): List&lt;VisitType&gt;\n  + setVisitsAttending(visits: List&lt;VisitType&gt;)\n  + addVisit(visit: VisitType)\n  + removeVisit(visit: VisitType)\n}\n\nclass TimeSlot {\n  - day: DayOfWeek\n  - startTime: LocalTime\n  - duration: Duration\n  + TimeSlot(day: DayOfWeek, startTime: LocalTime, duration: Duration)\n  + getDay(): DayOfWeek\n  + setDay(day: DayOfWeek)\n  + getStartTime(): LocalTime\n  + setStartTime(startTime: LocalTime)\n  + getDuration(): Duration\n  + setDuration(duration: Duration)\n}\n\nclass Place {\n  - placeTitle: String\n  - placeDescription: String\n  - location: String\n  - visits: List&lt;VisitType&gt;\n  + Place(placeTitle: String, placeDescription: String, location: String)\n  + getPlaceTitle(): String\n  + setPlaceTitle(placeTitle: String)\n  + getPlaceDescription(): String\n  + setPlaceDescription(placeDescription: String)\n  + getLocation(): String\n  + setLocation(location: String)\n  + getVisits(): List&lt;VisitType&gt;\n  + setVisits(visits: List&lt;VisitType&gt;)\n  + addVisit(visit: VisitType)\n  + removeVisit(visit: VisitType)\n}\n\nclass VisitType {\n  - visitTitle: String\n  - visitDescription: String\n  - visitMeetLocation: String\n  - validFrom: LocalDate\n  - validTo: LocalDate\n  - schedules: List&lt;TimeSlot&gt;\n  - ticketRequired: Boolean\n  - minParticipants: int\n  - maxParticipants: int\n  - place: Place\n  - guides: List&lt;Volunteer&gt;\n  - state: VisitState\n  - visitDate: LocalDate\n  - enrollmentDeadline: LocalDate\n  - enrolled: int\n  + VisitType(visitTitle: String, visitDescription: String, visitMeetLocation: String,\n             validFrom: LocalDate, validTo: LocalDate, schedules: List&lt;TimeSlot&gt;,\n             ticketRequired: Boolean, minParticipants: int, maxParticipants: int,\n             place: Place, guides: List&lt;Volunteer&gt;)\n  + addSchedule(timeSlot: TimeSlot)\n  + removeSchedule(timeSlot: TimeSlot)\n  + addGuide(volunteer: Volunteer)\n  + removeGuide(volunteer: Volunteer)\n  + addEnrollment(n: int)\n  + removeEnrollment(n: int)\n  + updateState(today: LocalDate)\n  + getVisitTitle(): String\n  + setVisitTitle(visitTitle: String)\n  + getVisitDescription(): String\n  + setVisitDescription(visitDescription: String)\n  + getVisitMeetLocation(): String\n  + setVisitMeetLocation(visitMeetLocation: String)\n  + getValidFrom(): LocalDate\n  + setValidFrom(validFrom: LocalDate)\n  + getValidTo(): LocalDate\n  + setValidTo(validTo: LocalDate)\n  + getSchedules(): List&lt;TimeSlot&gt;\n  + setSchedules(schedules: List&lt;TimeSlot&gt;)\n  + getTicketRequired(): Boolean\n  + setTicketRequired(ticketRequired: Boolean)\n  + getMinParticipants(): int\n  + setMinParticipants(minParticipants: int)\n  + getMaxParticipants(): int\n  + setMaxParticipants(maxParticipants: int)\n  + getPlace(): Place\n  + setPlace(place: Place)\n  + getGuides(): List&lt;Volunteer&gt;\n  + setGuides(guides: List&lt;Volunteer&gt;)\n  + getState(): VisitState\n  + getEnrolled(): int\n}\n\nenum VisitState {\n  PROPOSTA\n  COMPLETA\n  CONFERMATA\n  CANCELLATA\n  EFFETTUATA\n}\n}\n\npackage \&quot;DTO\&quot; {\nclass PlaceDTO {\n  - title: String\n  - description: String\n  - location: String\n  + PlaceDTO(title: String, description: String, location: String)\n  + getTitle(): String\n  + getDescription(): String\n  + getLocation(): String\n}\n\nclass VisitTypeDTO {\n  - title: String\n  - daySummary: String\n  - startTime: String\n  - endTime: String\n  - durationMinutes: int\n  - ticketRequired: boolean\n  - minParticipants: int\n  - maxParticipants: int\n  - placeID: String\n  - state: VisitState\n  + VisitTypeDTO(title: String, daySummary: String, startTime: String, endTime: String,\n                 durationMinutes: int, ticketRequired: boolean, minParticipants: int,\n                 maxParticipants: int, placeID: String, state: VisitState)\n  + getTitle(): String\n  + getDaySummary(): String\n  + getStartTime(): String\n  + getendTime(): String\n  + getDurationMinutes(): int\n  + isTicketRequired(): boolean\n  + getMinParticipants(): int\n  + getMaxParticipants(): int\n  + getPlaceID(): String\n  + getState(): VisitState\n}\n\nclass VolunteerDTO {\n  - nickname: String\n  - visitTypeTitles: List&lt;String&gt;\n  + VolunteerDTO(nickname: String, visitTypeTitles: List&lt;String&gt;)\n  + getNickname(): String\n  + getVisitTypeTitles(): List&lt;String&gt;\n}\n}\n\npackage \&quot;repository\&quot; {\ninterface SettingsRepository {\n  + load(): Optional&lt;SystemSettings&gt;\n  + save(settings: SystemSettings)\n  + exists(): boolean\n}\n\nclass JSONSettingsRepository {\n  - file: Path\n  - cache: SystemSettings\n  + JSONSettingsRepository(file: Path)\n  + load(): Optional&lt;SystemSettings&gt;\n  + save(settings: SystemSettings)\n  + exists(): boolean\n  + updateMaxPeoplePerSubscription(newValue: int)\n}\n\ninterface VolunteerRepository {\n  + findByNickname(nickname: String): Optional&lt;Volunteer&gt;\n  + findAll(): List&lt;Volunteer&gt;\n  + save(volunteer: Volunteer)\n  + deleteByNickname(nickname: String)\n}\n\nclass JSONVolunteerRepository {\n  - file: Path\n  - cache: Map&lt;String, Volunteer&gt;\n  + JSONVolunteerRepository(file: Path)\n  + findByNickname(nickname: String): Optional&lt;Volunteer&gt;\n  + findAll(): List&lt;Volunteer&gt;\n  + save(volunteer: Volunteer)\n  + deleteByNickname(nickname: String)\n}\n\ninterface VisitTypeRepository {\n  + findById(id: String): Optional&lt;VisitType&gt;\n  + findByPlace(placeID: String): List&lt;VisitType&gt;\n  + findAll(): List&lt;VisitType&gt;\n  + findByState(states: VisitState...): List&lt;VisitType&gt;\n  + save(visitType: VisitType)\n  + deleteById(id: String)\n}\n\nclass JSONVisitTypeRepository {\n  - file: Path\n  - cache: Map&lt;String, VisitType&gt;\n  + JSONVisitTypeRepository(file: Path)\n  + findById(id: String): Optional&lt;VisitType&gt;\n  + findByPlace(placeID: String): List&lt;VisitType&gt;\n  + findByState(states: VisitState...): List&lt;VisitType&gt;\n  + findAll(): List&lt;VisitType&gt;\n  + save(visitType: VisitType)\n  + deleteById(id: String)\n}\n\ninterface PlaceRepository {\n  + findById(id: String): Optional&lt;Place&gt;\n  + findAll(): List&lt;Place&gt;\n  + save(place: Place)\n  + deleteById(id: String)\n}\n\nclass JSONPlaceRepository {\n  - file: Path\n  - cache: Map&lt;String, Place&gt;\n  + JSONPlaceRepository(file: Path)\n  + findById(id: String): Optional&lt;Place&gt;\n  + findAll(): List&lt;Place&gt;\n  + save(place: Place)\n  + deleteById(id: String)\n}\n\ninterface ConfiguratorRepository {\n  + load(): Optional&lt;Map&lt;String, Configurator&gt;&gt;\n  + save(configurator: Configurator)\n  + exists(): boolean\n}\n\nclass JSONConfiguratorRepository {\n  - file: Path\n  - cache: Map&lt;String, Configurator&gt;\n  + JSONConfiguratorRepository(file: Path)\n  + load(): Optional&lt;Map&lt;String, Configurator&gt;&gt;\n  + save(configurator: Configurator)\n  + exists(): boolean\n}\n}\n\npackage \&quot;service\&quot; {\ninterface ConfiguratorService {\n  + isFirstAccessPending(): boolean\n  + verifyDefaultCredentials(nickname: String, password: String)\n  + setPersonalCredentials(nickname: String, password: String)\n  + verifyLogin(nickname: String, password: String): boolean\n  + setTerritorialScope(scope: String)\n  + setMaxPeoplePerSubscription(max: int)\n  + addPlace(name: String, description: String, location: String): String\n  + addVisitType(placeID: String, title: String, description: String, meetLocation: String,\n                 schedules: List&lt;TimeSlot&gt;, ticketRequired: boolean, minParticipants: int,\n                 maxParticipants: int, validFrom: LocalDate, validTo: LocalDate): String\n  + addVolunteer(nickname: String)\n  + linkVOlunteerToVisit(nickname: String, visitTypeId: String)\n  + listPlace(): List&lt;PlaceDTO&gt;\n  + listVisitTypeByPlace(placeId: String): List&lt;VisitTypeDTO&gt;\n  + listVisitType(): List&lt;VisitTypeDTO&gt;\n  + listVolunteerWVisitType(): List&lt;VolunteerDTO&gt;\n  + setBlackoutDates(excludedDates: List&lt;LocalDate&gt;)\n}\n\nclass ConfiguratorServiceImp {\n  - DEFAULT_NICKNAME: String\n  - DEFAULT_PASSWORD: String\n  - placeRepository: PlaceRepository\n  - visitTypeRepository: VisitTypeRepository\n  - volunteerRepository: VolunteerRepository\n  - settingsRepository: SettingsRepository\n  - configuratorRepository: ConfiguratorRepository\n  - defaultCredentialsValidated: boolean\n  + ConfiguratorServiceImp(placeRepository: PlaceRepository,\n      visitTypeRepository: VisitTypeRepository,\n      volunteerRepository: VolunteerRepository,\n      settingsRepository: SettingsRepository,\n      configuratorRepository: ConfiguratorRepository)\n  + isFirstAccessPending(): boolean\n  + verifyDefaultCredentials(nickname: String, password: String)\n  + setPersonalCredentials(nickname: String, password: String)\n  + verifyLogin(nickname: String, password: String): boolean\n  + setTerritorialScope(scope: String)\n  + setMaxPeoplePerSubscription(max: int)\n  + addPlace(name: String, description: String, location: String): String\n  + addVisitType(...): String\n  + addVolunteer(nickname: String)\n  + linkVOlunteerToVisit(nickname: String, visitTypeId: String)\n  + listPlace(): List&lt;PlaceDTO&gt;\n  + listVisitTypeByPlace(placeId: String): List&lt;VisitTypeDTO&gt;\n  + listVisitType(): List&lt;VisitTypeDTO&gt;\n  + listVolunteerWVisitType(): List&lt;VolunteerDTO&gt;\n  + setBlackoutDates(dates: List&lt;LocalDate&gt;)\n}\n}\n\npackage \&quot;util\&quot; {\nclass DTOMapper &lt;&lt;static&gt;&gt; {\n  + placeToDTO(p: Place): PlaceDTO\n  + visitTypeToDTO(vt: VisitType): VisitTypeDTO\n  + volunteerToDTO(v: Volunteer): VolunteerDTO\n}\n\nclass JSONSupport &lt;&lt;static&gt;&gt; {\n  + serializeConfigurator(map: Map&lt;String, Configurator&gt;): String\n  + deserializeConfigurator(json: String): Map&lt;String, Configurator&gt;\n  + serializeVolunteerMap(map: Map&lt;String, Volunteer&gt;): String\n  + deserializeVolunteerMap(json: String): Map&lt;String, Volunteer&gt;\n  + serializePlaceMap(map: Map&lt;String, Place&gt;): String\n  + deserializePlaceMap(json: String): Map&lt;String, Place&gt;\n  + serializeVisitTypeMap(map: Map&lt;String, VisitType&gt;): String\n  + deserializeVisitTypeMap(json: String): Map&lt;String, VisitType&gt;\n  + serializeSystemSettings(settings: SystemSettings): String\n  + deserializeSystemSettings(json: String): SystemSettings\n}\n\nclass ExcludedDatePolicy &lt;&lt;static&gt;&gt; {\n  + allowedMonth(referenceDate: LocalDate): YearMonth\n}\n}\n\npackage \&quot;cli\&quot; {\nclass PromptReader {\n  - scanner: Scanner\n  + PromptReader(scanner: Scanner)\n  + readLine(prompt: String): String\n  + readBoolean(prompt: String): boolean\n  + readValues(prompt: String, separator: String): List&lt;String&gt;\n}\n\nclass Printer {\n  - out: PrintStream\n  + Printer(out: PrintStream)\n  + println(text: String)\n  + print(text: String)\n  + printPlaceList(places: List&lt;PlaceDTO&gt;)\n  + printVisitTypeList(visitTypes: List&lt;VisitTypeDTO&gt;)\n  + printVolunteerList(volunteers: List&lt;VolunteerDTO&gt;)\n}\n\nclass CommandHandler {\n  - service: ConfiguratorService\n  - printer: Printer\n  - reader: PromptReader\n  + CommandHandler(service: ConfiguratorService, printer: Printer, prompt: PromptReader)\n  + handle(command: String): boolean\n  + listPlaces(): boolean\n  + listVisitTypeByPlace(): boolean\n  + listVisitTypeWithState(): boolean\n  + listVolunteer(): boolean\n  + setBlackOutDates(): boolean\n  + setMaxPeoplePerSub(): boolean\n}\n\nclass CommandRouter {\n  - handlers: Map&lt;String, BooleanSupplier&gt;\n  + CommandRouter()\n  + CommandRouter(handler: CommandHandler)\n  + register(command: String, handler: BooleanSupplier): CommandRouter\n  + route(command: String): boolean\n  + normalize(command: String): String\n}\n\nclass CliApp {\n  - reader: PromptReader\n  - printer: Printer\n  - router: CommandRouter\n  - running: boolean\n  + CliApp(reader: PromptReader, printer: Printer, router: CommandRouter)\n  + run()\n  + start()\n  + stop()\n  + isRunning(): boolean\n}\n\nclass FirstAccessSetup {\n  - service: ConfiguratorService\n  - reader: PromptReader\n  - printer: Printer\n  + FirstAccessSetup(service: ConfiguratorService, reader: PromptReader, printer: Printer)\n  + run()\n}\n\nclass Main {\n  + main(args: String[])\n  {static} - buildService(): ConfiguratorService\n}\n}\n\n&#39; Relationships within model\nPlace \&quot;1\&quot; o-- \&quot;*\&quot; VisitType\nVisitType \&quot;*\&quot; o-- \&quot;*\&quot; Volunteer\nVisitType \&quot;*\&quot; o-- \&quot;*\&quot; TimeSlot\nVolunteer \&quot;*\&quot; o-- \&quot;*\&quot; VisitType\nVisitType --&gt; VisitState\n\n&#39; DTO mappers\nDTOMapper ..&gt; Place\nDTOMapper ..&gt; VisitType\nDTOMapper ..&gt; Volunteer\nDTOMapper ..&gt; PlaceDTO\nDTOMapper ..&gt; VisitTypeDTO\nDTOMapper ..&gt; VolunteerDTO\n\n&#39; Service dependencies\nConfiguratorService &lt;|.. ConfiguratorServiceImp\nConfiguratorServiceImp --&gt; PlaceRepository\nConfiguratorServiceImp --&gt; VisitTypeRepository\nConfiguratorServiceImp --&gt; VolunteerRepository\nConfiguratorServiceImp --&gt; SettingsRepository\nConfiguratorServiceImp --&gt; ConfiguratorRepository\nConfiguratorServiceImp ..&gt; DTOMapper\nConfiguratorServiceImp ..&gt; ExcludedDatePolicy\nConfiguratorServiceImp ..&gt; Place\nConfiguratorServiceImp ..&gt; VisitType\nConfiguratorServiceImp ..&gt; Volunteer\nConfiguratorServiceImp ..&gt; SystemSettings\n\n&#39; Repository implementations\nSettingsRepository &lt;|.. JSONSettingsRepository\nJSONSettingsRepository ..&gt; JSONSupport\nVolunteerRepository &lt;|.. JSONVolunteerRepository\nJSONVolunteerRepository ..&gt; JSONSupport\nVisitTypeRepository &lt;|.. JSONVisitTypeRepository\nJSONVisitTypeRepository ..&gt; JSONSupport\nPlaceRepository &lt;|.. JSONPlaceRepository\nJSONPlaceRepository ..&gt; JSONSupport\nConfiguratorRepository &lt;|.. JSONConfiguratorRepository\nJSONConfiguratorRepository ..&gt; JSONSupport\n\n&#39; CLI dependencies\nCommandHandler --&gt; ConfiguratorService\nCommandHandler --&gt; Printer\nCommandHandler --&gt; PromptReader\nCommandHandler ..&gt; PlaceDTO\nCommandHandler ..&gt; VisitTypeDTO\nCommandHandler ..&gt; VolunteerDTO\nCommandHandler ..&gt; ExcludedDatePolicy\nCommandHandler ..&gt; LocalDate\nCommandHandler ..&gt; YearMonth\n\nCommandRouter --&gt; CommandHandler\nCliApp --&gt; PromptReader\nCliApp --&gt; Printer\nCliApp --&gt; CommandRouter\nFirstAccessSetup --&gt; ConfiguratorService\nFirstAccessSetup --&gt; PromptReader\nFirstAccessSetup --&gt; Printer\n\nMain ..&gt; ConfiguratorServiceImp\nMain ..&gt; JSONPlaceRepository\nMain ..&gt; JSONVisitTypeRepository\nMain ..&gt; JSONVolunteerRepository\nMain ..&gt; JSONSettingsRepository\nMain ..&gt; JSONConfiguratorRepository\nMain ..&gt; CliApp\nMain ..&gt; CommandRouter\nMain ..&gt; CommandHandler\nMain ..&gt; FirstAccessSetup\nMain ..&gt; Printer\nMain ..&gt; PromptReader\n\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="qgRkk2PFUXJn3M-PLXa2-20">
