        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\nskinparam shadowing false\nskinparam packageStyle rectangle\n\npackage \&quot;model\&quot; {\n  class Configurator {\n    - nickname: String\n    - password: String\n    + Configurator(nickname: String, password: String)\n    + getNickname(): String\n    + getPassword(): String\n  }\n\n  class SystemSettings {\n    - territorialScope: String\n    - maxPeoplePerSubscription: int\n    - excludedDates: List&lt;LocalDate&gt;\n    - activePlanningMonth: YearMonth\n    - planningPhase: PlanningPhase\n    - lastAvailabilityWindowClosure: LocalDate\n    + SystemSettings(scope: String, max: int, excluded: List&lt;LocalDate&gt;)\n    + SystemSettings(scope: String, max: int, excluded: List&lt;LocalDate&gt;,\n                     activeMonth: YearMonth, phase: PlanningPhase,\n                     lastClosure: LocalDate)\n    + getTerritorialScope(): String\n    + getMaxPeoplePerSubscription(): int\n    + getExcludedDates(): List&lt;LocalDate&gt;\n    + getActivePlanningMonth(): YearMonth\n    + getPlanningPhase(): PlanningPhase\n    + getLastAvailabilityWindowClosure(): LocalDate\n    + setExcludedDates(dates: List&lt;LocalDate&gt;)\n    + setPlanningPhase(phase: PlanningPhase)\n    + setActivePlanningMonth(month: YearMonth)\n  }\n\n  class TimeSlot {\n    - day: DayOfWeek\n    - startTime: LocalTime\n    - duration: Duration\n    + TimeSlot(day: DayOfWeek, start: LocalTime, duration: Duration)\n    + getDay(): DayOfWeek\n    + getStartTime(): LocalTime\n    + getDuration(): Duration\n  }\n\n  class Place {\n    - placeTitle: String\n    - placeDescription: String\n    - location: String\n    - visits: List&lt;VisitType&gt;\n    + Place(title: String, description: String, location: String)\n    + getPlaceTitle(): String\n    + getVisits(): List&lt;VisitType&gt;\n    + setVisits(visits: List&lt;VisitType&gt;)\n    + addVisit(visit: VisitType)\n    + removeVisit(visit: VisitType)\n  }\n\n  class VisitType {\n    - id: String\n    - visitTitle: String\n    - visitDescription: String\n    - visitMeetLocation: String\n    - validFrom: LocalDate\n    - validTo: LocalDate\n    - schedules: List&lt;TimeSlot&gt;\n    - ticketRequired: Boolean\n    - minParticipants: int\n    - maxParticipants: int\n    - place: Place\n    - guides: List&lt;Volunteer&gt;\n    - state: VisitState\n    + VisitType(title: String, description: String, meetLocation: String,\n                validFrom: LocalDate, validTo: LocalDate,\n                schedules: List&lt;TimeSlot&gt;, ticketRequired: Boolean,\n                minParticipants: int, maxParticipants: int,\n                place: Place, guides: List&lt;Volunteer&gt;)\n    + getId(): String\n    + getVisitTitle(): String\n    + getSchedules(): List&lt;TimeSlot&gt;\n    + getGuides(): List&lt;Volunteer&gt;\n    + addGuide(volunteer: Volunteer)\n    + removeGuide(volunteer: Volunteer)\n    + generateOccurrences(month: YearMonth): List&lt;PlannedVisit&gt;\n    + isValidOn(date: LocalDate): boolean\n  }\n\n  class Volunteer {\n    - nickname: String\n    - password: String\n    - personalCredentialsDefined: boolean\n    - visitsAttending: List&lt;VisitType&gt;\n    - availabilities: Map&lt;YearMonth, MonthlyAvailability&gt;\n    - scheduledShifts: Map&lt;YearMonth, List&lt;AssignedShift&gt;&gt;\n    - active: boolean\n    + Volunteer(nickname: String, password: String)\n    + getNickname(): String\n    + isFirstAccessPending(): boolean\n    + isActive(): boolean\n    + getVisitsAttending(): List&lt;VisitType&gt;\n    + getAvailabilities(): Map&lt;YearMonth, MonthlyAvailability&gt;\n    + getScheduledShifts(): Map&lt;YearMonth, List&lt;AssignedShift&gt;&gt;\n    + addVisit(visit: VisitType)\n    + removeVisit(visit: VisitType)\n    + registerAvailability(availability: MonthlyAvailability, today: LocalDate)\n    + findAvailability(month: YearMonth): Optional&lt;MonthlyAvailability&gt;\n    + assignShifts(month: YearMonth, shifts: List&lt;AssignedShift&gt;)\n    + removeScheduledShifts(month: YearMonth)\n    + clearAvailabilities()\n    + deactivate()\n  }\n\n  class MonthlyAvailability {\n    - referenceMonth: YearMonth\n    - preferredDays: EnumSet&lt;DayOfWeek&gt;\n    - weeklyFrequency: int\n    - submittedOn: LocalDate\n    - snapshot: boolean\n    - snapshotCapturedOn: LocalDate\n    + MonthlyAvailability(referenceMonth: YearMonth, preferredDays: Set&lt;DayOfWeek&gt;,\n                          weeklyFrequency: int, submittedOn: LocalDate)\n    + MonthlyAvailability(referenceMonth: YearMonth, preferredDays: Set&lt;DayOfWeek&gt;,\n                          weeklyFrequency: int, submittedOn: LocalDate,\n                          snapshot: boolean, snapshotCapturedOn: LocalDate)\n    + getReferenceMonth(): YearMonth\n    + getPreferredDays(): EnumSet&lt;DayOfWeek&gt;\n    + getWeeklyFrequency(): int\n    + getSubmittedOn(): LocalDate\n    + isSnapshot(): boolean\n    + getSnapshotCapturedOn(): LocalDate\n    + createSnapshot(capturedOn: LocalDate): MonthlyAvailability\n    + resolveAvailableDates(): List&lt;LocalDate&gt;\n    + validateWindow(today: LocalDate)\n    + ensureConsistency()\n  }\n\n  class AssignedShift {\n    - date: LocalDate\n    - visitTypeId: String\n    - slot: TimeSlot\n    + AssignedShift(date: LocalDate, visitTypeId: String, slot: TimeSlot)\n    + getDate(): LocalDate\n    + getVisitTypeId(): String\n    + getSlot(): TimeSlot\n  }\n\n  class PlannedVisit {\n    - date: LocalDate\n    - timeSlot: TimeSlot\n    - visitTypeId: String\n    - assignedVolunteerIds: List&lt;String&gt;\n    - proposable: boolean\n    + PlannedVisit(date: LocalDate, timeSlot: TimeSlot, visitTypeId: String, proposable: boolean)\n    + getDate(): LocalDate\n    + getTimeSlot(): TimeSlot\n    + getVisitTypeId(): String\n    + isProposable(): boolean\n    + setProposable(proposable: boolean)\n    + getAssignedVolunteerIds(): List&lt;String&gt;\n    + assignVolunteer(volunteerId: String)\n    + unassignVolunteer(volunteerId: String): boolean\n    + clearAssignements()\n  }\n\n  class MonthlyVisitPlan {\n    - targetMonth: YearMonth\n    - phase: PlanningPhase\n    - availabilityWindowClosedOn: LocalDate\n    - plannedVisits: List&lt;PlannedVisit&gt;\n    - availabilitySnapshots: Map&lt;String, MonthlyAvailability&gt;\n    + MonthlyVisitPlan(targetMonth: YearMonth)\n    + MonthlyVisitPlan(targetMonth: YearMonth, phase: PlanningPhase,\n                       closedOn: LocalDate, visits: List&lt;PlannedVisit&gt;,\n                       snapshots: Map&lt;String, MonthlyAvailability&gt;)\n    + getTargetMonth(): YearMonth\n    + getPhase(): PlanningPhase\n    + getAvailabilitySnapshots(): Map&lt;String, MonthlyAvailability&gt;\n    + getPlannedVisits(): List&lt;PlannedVisit&gt;\n    + setPhase(phase: PlanningPhase)\n    + recordAvailabilitySnapshot(volunteerId: String, availability: MonthlyAvailability)\n    + removeAvailabilitySnapshot(volunteerId: String)\n    + replacePlannedVisits(visits: List&lt;PlannedVisit&gt;)\n    + addPlannedVisit(visit: PlannedVisit)\n    + removePlannedVisit(visit: PlannedVisit)\n    + removeVisitsByVisitType(visitTypeId: String): boolean\n    + removeVisitsByVisitTypes(ids: Iterable&lt;String&gt;): boolean\n    + removeVolunteerAssignments(volunteerId: String): boolean\n  }\n\n  enum PlanningPhase {\n    AVAILABILITY_COLLECTION_OPEN,\n    AVAILABILITY_COLLECTION_CLOSED,\n    PLAN_GENERATED,\n    ASSIGNMENT,\n    REVIEW,\n    READY_FOR_NEXT_CYCLE,\n    CATALOG_MANAGEMENT\n  }\n\n  enum VisitState {\n    PROPOSTA,\n    COMPLETA,\n    CONFERMATA,\n    CANCELLATA,\n    EFFETTUATA\n  }\n}\n\npackage \&quot;DTO\&quot; {\n  class PlaceDTO {\n    - title: String\n    - description: String\n    - location: String\n    + PlaceDTO(title: String, description: String, location: String)\n    + getTitle(): String\n    + getDescription(): String\n    + getLocation(): String\n  }\n\n  class VisitTypeDTO {\n    - id: String\n    - title: String\n    - daySummary: String\n    - startTime: String\n    - endTime: String\n    - durationMinutes: int\n    - ticketRequired: boolean\n    - minParticipants: int\n    - maxParticipants: int\n    - placeID: String\n    - state: VisitState\n    + VisitTypeDTO(id: String, title: String, daySummary: String,\n                   startTime: String, endTime: String, durationMinutes: int,\n                   ticketRequired: boolean, minParticipants: int,\n                   maxParticipants: int, placeID: String, state: VisitState)\n    + getId(): String\n    + getTitle(): String\n    + getDaySummary(): String\n    + getStartTime(): String\n    + getendTime(): String\n  }\n\n  class VolunteerAvailabilityDTO {\n    - referenceMonth: YearMonth\n    - preferredDays: List&lt;DayOfWeek&gt;\n    - weeklyFrequency: int\n    - submittedOn: LocalDate\n    + VolunteerAvailabilityDTO(referenceMonth: YearMonth,\n                               preferredDays: List&lt;DayOfWeek&gt;,\n                               weeklyFrequency: int,\n                               submittedOn: LocalDate)\n  }\n\n  class AssignedShiftDTO {\n    - month: YearMonth\n    - date: LocalDate\n    - visitTypeId: String\n    - slot: TimeSlot\n    + AssignedShiftDTO(month: YearMonth, date: LocalDate,\n                       visitTypeId: String, slot: TimeSlot)\n  }\n\n  class VolunteerDTO {\n    - nickname: String\n    - password: String\n    - firstAccessPending: boolean\n    - visitTypeTitles: List&lt;String&gt;\n    - availabilities: List&lt;VolunteerAvailabilityDTO&gt;\n    - scheduledShifts: List&lt;AssignedShiftDTO&gt;\n    + VolunteerDTO(nickname: String, password: String,\n                   firstAccessPending: boolean,\n                   visitTypeTitles: List&lt;String&gt;,\n                   availabilities: List&lt;VolunteerAvailabilityDTO&gt;,\n                   scheduledShifts: List&lt;AssignedShiftDTO&gt;)\n  }\n\n  class PlannedVisitDTO {\n    - month: YearMonth\n    - date: LocalDate\n    - dayOfWeek: DayOfWeek\n    - startTime: LocalTime\n    - durationMinutes: long\n    - visitTypeId: String\n    - visitTitle: String\n    - proposable: boolean\n    - assignedVolunteers: List&lt;String&gt;\n    + PlannedVisitDTO(month: YearMonth, date: LocalDate,\n                      dayOfWeek: DayOfWeek, start: LocalTime,\n                      durationMinutes: long, visitTypeId: String,\n                      visitTitle: String, proposable: boolean,\n                      assignedVolunteers: List&lt;String&gt;)\n  }\n\n  class PlanAvailabilityDTO {\n    - volunteerNickname: String\n    - referenceMonth: YearMonth\n    - preferredDays: List&lt;DayOfWeek&gt;\n    - weeklyFrequency: int\n    - submittedOn: LocalDate\n    - snapshotCapturedOn: LocalDate\n    + PlanAvailabilityDTO(volunteerNickname: String, referenceMonth: YearMonth,\n                          preferredDays: List&lt;DayOfWeek&gt;, weeklyFrequency: int,\n                          submittedOn: LocalDate, snapshotCapturedOn: LocalDate)\n  }\n\n  class MonthlyPlanDTO {\n    - targetMonth: YearMonth\n    - phase: PlanningPhase\n    - availabilityWindowClosedOn: LocalDate\n    - plannedVisits: List&lt;PlannedVisitDTO&gt;\n    - availabilitySnapshots: List&lt;PlanAvailabilityDTO&gt;\n    + MonthlyPlanDTO(targetMonth: YearMonth, phase: PlanningPhase,\n                     availabilityWindowClosedOn: LocalDate,\n                     plannedVisits: List&lt;PlannedVisitDTO&gt;,\n                     availabilitySnapshots: List&lt;PlanAvailabilityDTO&gt;)\n  }\n}\n\npackage \&quot;repository\&quot; {\n  interface ConfiguratorRepository {\n    + load(): Optional&lt;Map&lt;String, Configurator&gt;&gt;\n    + save(configurator: Configurator)\n    + exists(): boolean\n  }\n\n  interface SettingsRepository {\n    + load(): Optional&lt;SystemSettings&gt;\n    + save(settings: SystemSettings)\n    + exists(): boolean\n  }\n\n  interface PlaceRepository {\n    + findById(id: String): Optional&lt;Place&gt;\n    + findAll(): List&lt;Place&gt;\n    + save(place: Place)\n    + deleteById(id: String)\n  }\n\n  interface VisitTypeRepository {\n    + findById(id: String): Optional&lt;VisitType&gt;\n    + findByPlace(placeId: String): List&lt;VisitType&gt;\n    + findByState(states: VisitState...): List&lt;VisitType&gt;\n    + findAll(): List&lt;VisitType&gt;\n    + save(visitType: VisitType)\n    + deleteById(id: String)\n  }\n\n  interface VolunteerRepository {\n    + findByNickname(nickname: String): Optional&lt;Volunteer&gt;\n    + findAll(): List&lt;Volunteer&gt;\n    + save(volunteer: Volunteer)\n    + deleteByNickname(nickname: String)\n    + exist(): boolean\n  }\n\n  interface MonthlyVisitPlanRepository {\n    + findByMonth(month: YearMonth): Optional&lt;MonthlyVisitPlan&gt;\n    + findAll(): List&lt;MonthlyVisitPlan&gt;\n    + save(plan: MonthlyVisitPlan)\n    + deleteByMonth(month: YearMonth)\n    + removePlannedVisitsByVisitType(visitTypeId: String)\n    + removePlannedVisitsByVisitTypes(ids: Iterable&lt;String&gt;)\n    + removeVolunteerAssignments(volunteerId: String)\n  }\n\n  class JSONConfiguratorRepository implements ConfiguratorRepository {\n    - file: Path\n    - cache: Map&lt;String, Configurator&gt;\n    + JSONConfiguratorRepository(file: Path)\n    + load(): Optional&lt;Map&lt;String, Configurator&gt;&gt;\n    + save(configurator: Configurator)\n    + exists(): boolean\n  }\n\n  class JSONSettingsRepository implements SettingsRepository {\n    - file: Path\n    - cache: SystemSettings\n    + JSONSettingsRepository(file: Path)\n    + load(): Optional&lt;SystemSettings&gt;\n    + save(settings: SystemSettings)\n    + exists(): boolean\n  }\n\n  class JSONPlaceRepository implements PlaceRepository {\n    - file: Path\n    - cache: Map&lt;String, Place&gt;\n    - planRepository: MonthlyVisitPlanRepository\n    + JSONPlaceRepository(file: Path)\n    + JSONPlaceRepository(file: Path, planRepository: MonthlyVisitPlanRepository)\n    + findById(id: String): Optional&lt;Place&gt;\n    + findAll(): List&lt;Place&gt;\n    + save(place: Place)\n    + deleteById(id: String)\n  }\n\n  class JSONVisitTypeRepository implements VisitTypeRepository {\n    - file: Path\n    - cache: Map&lt;String, VisitType&gt;\n    - planRepository: MonthlyVisitPlanRepository\n    + JSONVisitTypeRepository(file: Path)\n    + JSONVisitTypeRepository(file: Path, planRepository: MonthlyVisitPlanRepository)\n    + findById(id: String): Optional&lt;VisitType&gt;\n    + findByPlace(placeId: String): List&lt;VisitType&gt;\n    + findAll(): List&lt;VisitType&gt;\n    + save(visitType: VisitType)\n    + deleteById(id: String)\n  }\n\n  class JSONVolunteerRepository implements VolunteerRepository {\n    - file: Path\n    - cache: Map&lt;String, Volunteer&gt;\n    - planRepository: MonthlyVisitPlanRepository\n    + JSONVolunteerRepository(file: Path)\n    + JSONVolunteerRepository(file: Path, planRepository: MonthlyVisitPlanRepository)\n    + findByNickname(nickname: String): Optional&lt;Volunteer&gt;\n    + findAll(): List&lt;Volunteer&gt;\n    + save(volunteer: Volunteer)\n    + deleteByNickname(nickname: String)\n    + exist(): boolean\n  }\n\n  class JSONMonthlyVisitPlanRepository implements MonthlyVisitPlanRepository {\n    - file: Path\n    - cache: Map&lt;YearMonth, MonthlyVisitPlan&gt;\n    + JSONMonthlyVisitPlanRepository(file: Path)\n    + findByMonth(month: YearMonth): Optional&lt;MonthlyVisitPlan&gt;\n    + findAll(): List&lt;MonthlyVisitPlan&gt;\n    + save(plan: MonthlyVisitPlan)\n    + deleteByMonth(month: YearMonth)\n    + removePlannedVisitsByVisitType(visitTypeId: String)\n    + removePlannedVisitsByVisitTypes(ids: Iterable&lt;String&gt;)\n    + removeVolunteerAssignments(volunteerId: String)\n  }\n}\n\npackage \&quot;service\&quot; {\n  interface LoginService {\n    + verifyDefaultCredentials(nickname: String, password: String)\n    + setPersonalCredentials(currentNickname: String, newNickname: String, password: String)\n    + verifyLogin(nickname: String, password: String): boolean\n    + isFirstAccessPending(nickname: String): boolean\n  }\n\n  interface ConfiguratorService extends LoginService {\n    + setTerritorialScope(scope: String)\n    + setMaxPeoplePerSubscription(max: int)\n    + addPlace(name: String, description: String, location: String): String\n    + addVisitType(placeId: String, title: String, description: String,\n                   meetLocation: String, schedules: List&lt;TimeSlot&gt;,\n                   ticketRequired: boolean, minParticipants: int,\n                   maxParticipants: int, validFrom: LocalDate, validTo: LocalDate): String\n    + addVolunteer(nickname: String, defaultPassword: String)\n    + linkVOlunteerToVisit(nickname: String, visitTypeId: String)\n    + listPlace(): List&lt;PlaceDTO&gt;\n    + listVisitTypeByPlace(placeId: String): List&lt;VisitTypeDTO&gt;\n    + listVisitType(): List&lt;VisitTypeDTO&gt;\n    + listVolunteerWVisitType(): List&lt;VolunteerDTO&gt;\n    + setBlackoutDates(excludedDates: List&lt;LocalDate&gt;)\n    + closeAvailabilityWindow(today: LocalDate)\n    + applyCatalogChange(change: Runnable)\n    + generateMonthlyPlan(targetMonth: YearMonth): MonthlyPlanDTO\n    + getMonthlyPlanDetails(month: YearMonth): MonthlyPlanDTO\n    + assignVolunteerToPlannedVisit(month: YearMonth, date: LocalDate,\n                                     slot: TimeSlot, visitTypeId: String,\n                                     volunteerNickname: String)\n    + removePlannedVisit(month: YearMonth, date: LocalDate,\n                         slot: TimeSlot, visitTypeId: String)\n    + removePlace(placeId: String)\n    + removeVisitType(visitTypeId: String)\n    + removeVolunteer(nickname: String)\n    + reopenAvailabilityWindow(today: LocalDate)\n  }\n\n  interface VolunteerService extends LoginService {\n    + submitAvailability(nickname: String, availability: MonthlyAvailability, today: LocalDate)\n    + loadAvailability(nickname: String, month: YearMonth): Optional&lt;MonthlyAvailability&gt;\n    + loadSchedule(nickname: String, month: YearMonth): List&lt;AssignedShift&gt;\n    + assignShifts(nickname: String, month: YearMonth, shifts: List&lt;AssignedShift&gt;)\n    + snapshotAvailabilities(month: YearMonth, capturedOn: LocalDate): Map&lt;String, MonthlyAvailability&gt;\n    + removeVolunteerAccount(nickname: String)\n  }\n\n  class ConfiguratorServiceImp implements ConfiguratorService {\n    {static} + DEFAULT_NICKNAME: String\n    {static} + DEFAULT_PASSWORD: String\n    - placeRepository: PlaceRepository\n    - visitTypeRepository: VisitTypeRepository\n    - volunteerRepository: VolunteerRepository\n    - settingsRepository: SettingsRepository\n    - monthlyVisitPlanRepository: MonthlyVisitPlanRepository\n    - configuratorRepository: ConfiguratorRepository\n    - volunteerService: VolunteerService\n    - defaultCredentialsValidated: boolean\n    + ConfiguratorServiceImp(placeRepository: PlaceRepository,\n                             visitTypeRepository: VisitTypeRepository,\n                             volunteerRepository: VolunteerRepository,\n                             settingsRepository: SettingsRepository,\n                             monthlyVisitPlanRepository: MonthlyVisitPlanRepository,\n                             configuratorRepository: ConfiguratorRepository,\n                             volunteerService: VolunteerService)\n    + setTerritorialScope(scope: String)\n    + setMaxPeoplePerSubscription(max: int)\n    + addPlace(name: String, description: String, location: String): String\n    + addVisitType(...): String\n    + addVolunteer(nickname: String, defaultPassword: String)\n    + linkVOlunteerToVisit(nickname: String, visitTypeId: String)\n    + closeAvailabilityWindow(today: LocalDate)\n    + generateMonthlyPlan(targetMonth: YearMonth): MonthlyPlanDTO\n    + assignVolunteerToPlannedVisit(month: YearMonth, date: LocalDate,\n                                     slot: TimeSlot, visitTypeId: String,\n                                     volunteerNickname: String)\n    + removePlannedVisit(month: YearMonth, date: LocalDate,\n                         slot: TimeSlot, visitTypeId: String)\n    + removePlace(placeId: String)\n    + removeVisitType(visitTypeId: String)\n    + removeVolunteer(nickname: String)\n    + reopenAvailabilityWindow(today: LocalDate)\n  }\n\n  class VolunteerServiceImp implements VolunteerService {\n    - volunteerRepository: VolunteerRepository\n    - settingsRepository: SettingsRepository\n    - defaultCredentialsValidated: Set&lt;String&gt;\n    + VolunteerServiceImp(volunteerRepository: VolunteerRepository,\n                          settingsRepository: SettingsRepository)\n    + submitAvailability(nickname: String, availability: MonthlyAvailability, today: LocalDate)\n    + loadAvailability(nickname: String, month: YearMonth): Optional&lt;MonthlyAvailability&gt;\n    + loadSchedule(nickname: String, month: YearMonth): List&lt;AssignedShift&gt;\n    + assignShifts(nickname: String, month: YearMonth, shifts: List&lt;AssignedShift&gt;)\n    + snapshotAvailabilities(month: YearMonth, capturedOn: LocalDate): Map&lt;String, MonthlyAvailability&gt;\n    + removeVolunteerAccount(nickname: String)\n  }\n}\n\npackage \&quot;util\&quot; {\n  class DTOMapper &lt;&lt;static&gt;&gt; {\n    + placeToDTO(place: Place): PlaceDTO\n    + visitTypeToDTO(visit: VisitType): VisitTypeDTO\n    + volunteerToDTO(volunteer: Volunteer): VolunteerDTO\n    + planToDTO(plan: MonthlyVisitPlan, visitTypes: List&lt;VisitType&gt;): MonthlyPlanDTO\n  }\n\n  class JSONSupport &lt;&lt;static&gt;&gt; {\n    + serializeConfigurator(map: Map&lt;String, Configurator&gt;): String\n    + deserializeConfigurator(json: String): Map&lt;String, Configurator&gt;\n    + serializeVolunteerMap(map: Map&lt;String, Volunteer&gt;): String\n    + deserializeVolunteerMap(json: String): Map&lt;String, Volunteer&gt;\n    + serializePlaceMap(map: Map&lt;String, Place&gt;): String\n    + deserializePlaceMap(json: String): Map&lt;String, Place&gt;\n    + serializeVisitTypeMap(map: Map&lt;String, VisitType&gt;): String\n    + deserializeVisitTypeMap(json: String): Map&lt;String, VisitType&gt;\n    + serializeSystemSettings(settings: SystemSettings): String\n    + deserializeSystemSettings(json: String): SystemSettings\n    + serializeMonthlyVisitPlanMap(map: Map&lt;String, MonthlyVisitPlan&gt;): String\n    + deserializeMonthlyVisitPlanMap(json: String): Map&lt;String, MonthlyVisitPlan&gt;\n  }\n\n  class ExcludedDatePolicy &lt;&lt;static&gt;&gt; {\n    + allowedMonth(referenceDate: LocalDate): YearMonth\n  }\n\n  class AvailabilitySubmissionPolicy &lt;&lt;static&gt;&gt; {\n    + isWindowOpen(referenceMonth: YearMonth, today: LocalDate): boolean\n    + nextSubmissionMonth(today: LocalDate): YearMonth\n  }\n\n  class PlanningWindowPolicy &lt;&lt;static&gt;&gt; {\n    + resolveNextPlanningMonth(today: LocalDate): YearMonth\n  }\n}\n\npackage \&quot;cli\&quot; {\n  class PromptReader {\n    {static} - DEFAULT_SEPARATOR: String\n    - scanner: Scanner\n    + PromptReader(scanner: Scanner)\n    + readLine(prompt: String): String\n    + readBoolean(prompt: String): boolean\n    + readValues(prompt: String, separator: String): List&lt;String&gt;\n  }\n\n  class Printer {\n    {static} + PLACE_HEADER: String\n    {static} + VISIT_TYPE_HEADER: String\n    {static} + VOLUNTEER_HEADER: String\n    - out: PrintStream\n    + Printer(out: PrintStream)\n    + println(text: String)\n    + printPlaceList(places: List&lt;PlaceDTO&gt;)\n    + printVisitTypeList(visitTypes: List&lt;VisitTypeDTO&gt;)\n    + printVolunteerList(volunteers: List&lt;VolunteerDTO&gt;)\n  }\n\n  class FirstAccessSetup {\n    - service: ConfiguratorService\n    - volunteerService: VolunteerService\n    - reader: PromptReader\n    - printer: Printer\n    + FirstAccessSetup(service: ConfiguratorService, volunteerService: VolunteerService,\n                       reader: PromptReader, printer: Printer)\n    + run()\n    + handleVolunteerFirstAccess(nickname: String): String\n  }\n\n  class CommandRouter {\n    - handlers: Map&lt;String, BooleanSupplier&gt;\n    + CommandRouter()\n    + CommandRouter(handler: ConfiguratorCommandHandler)\n    + register(command: String, handler: BooleanSupplier): CommandRouter\n    + route(command: String): boolean\n    + normalize(command: String): String\n  }\n\n  class ConfiguratorCommandHandler {\n    - service: ConfiguratorService\n    - printer: Printer\n    - reader: PromptReader\n    + ConfiguratorCommandHandler(service: ConfiguratorService,\n                                 printer: Printer, reader: PromptReader)\n    + startSession()\n    + openSetupMenu(): boolean\n    + openListMenu(): boolean\n    + openSettingsMenu(): boolean\n    + openPlanningMenu(): boolean\n  }\n\n  class VolunteerCommandHandler {\n    - volunteerService: VolunteerService\n    - firstAccessSetup: FirstAccessSetup\n    - printer: Printer\n    - reader: PromptReader\n    - volunteerMenuRouter: CommandRouter\n    + VolunteerCommandHandler(volunteerService: VolunteerService,\n                               firstAccessSetup: FirstAccessSetup,\n                               printer: Printer, reader: PromptReader)\n    + startSession()\n    + submitVolunteerAvailability(): boolean\n    + showVolunteerAvailability(): boolean\n    + showVolunteerSchedule(): boolean\n  }\n\n  class VolunteerCliSupport &lt;&lt;static&gt;&gt; {\n    + displayAvailability(service: VolunteerService, printer: Printer,\n                          nickname: String, month: YearMonth,\n                          formatter: DateTimeFormatter)\n    + displaySchedule(service: VolunteerService, printer: Printer,\n                      nickname: String, month: YearMonth,\n                      formatter: DateTimeFormatter)\n  }\n\n  class CliApp implements Runnable {\n    - reader: PromptReader\n    - printer: Printer\n    - configuratorHandler: ConfiguratorCommandHandler\n    - voluntee